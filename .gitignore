# build output & sources
/sources/
/roms/*.rom
/roms/*.cap
/roms/*.cab

# flash dumps, backups, reference material - carries machine identity (MAC, serial, UEFI vars)
*.bin
/firmware/

# vboot signing keys - the private halves must never leave this machine
/keys/

# python bytecode from importing the build script
__pycache__/

# saved build images (see Cleaning up in the README)
*.tar.zst

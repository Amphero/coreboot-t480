CONFIG_VENDOR_LENOVO=y
CONFIG_BOARD_LENOVO_T480=y
CONFIG_IFD_BIN_PATH="binaries/ifd.bin"
CONFIG_ME_BIN_PATH="binaries/me.bin"
CONFIG_GBE_BIN_PATH="binaries/gbe.bin"
CONFIG_HAVE_IFD_BIN=y
CONFIG_HAVE_ME_BIN=y
CONFIG_HAVE_GBE_BIN=y
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_BOOTSPLASH_FILE="/opt/coreboot/splash.bmp"
CONFIG_EDK2_FOLLOW_BGRT_SPEC=y
CONFIG_MAINBOARD_SMBIOS_PRODUCT_NAME="ThinkPad T480"
# thinkpad_acpi probes DMI product_version for the word "ThinkPad"; the
# default "1.0" makes it refuse to load (modprobe: "No such device").
CONFIG_MAINBOARD_VERSION="ThinkPad T480"
# vboot: the RO section verifies the signed RW slots A/B before jumping in
# (docs/vboot-plan.md). Layout comes from vboot.fmd (patch 0040); with
# FMDFILE set, CBFS_SIZE no longer shapes the layout. Keys: devkeys for now.
CONFIG_VBOOT=y
CONFIG_FMDFILE="src/mainboard/lenovo/sklkbl_thinkpad/vboot.fmd"
# the SoC selects VBOOT_MUST_REQUEST_DISPLAY - without this, normal verified
# boots skip display init entirely (no splash, dark until the kernel)
CONFIG_VBOOT_ALWAYS_ENABLE_DISPLAY=y
# nothing else clears the recovery request with a non-vboot payload: the only
# other caller sits in the depthcharge path. Without this a single recovery
# event pins the machine to RO boots forever.
CONFIG_VBOOT_CLEAR_RECOVERY_IN_RAMSTAGE=y
# own signing keys from keys/ (never committed). Drop these four lines to fall
# back to the public vboot devkeys.
CONFIG_VBOOT_ROOT_KEY="/opt/keys/root_key.vbpubk"
CONFIG_VBOOT_RECOVERY_KEY="/opt/keys/recovery_key.vbpubk"
CONFIG_VBOOT_FIRMWARE_PRIVKEY="/opt/keys/firmware_data_key.vbprivk"
CONFIG_VBOOT_KEYBLOCK="/opt/keys/firmware.keyblock"
CONFIG_SMMSTORE=y
CONFIG_SMMSTORE_V2=y
CONFIG_SMMSTORE_SIZE=0x40000
CONFIG_EDK2_SECURE_BOOT_SUPPORT=y
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D VARIABLE_SUPPORT=SMMSTORE"
# measure all stages/blobs into TPM PCR 2 before running them (log: cbmem -L)
CONFIG_TPM_MEASURED_BOOT=y
# (machine identity + optional devicetree devices live in config/board.conf)

CONFIG_VENDOR_LENOVO=y
CONFIG_BOARD_LENOVO_T480=y
CONFIG_IFD_BIN_PATH="binaries/ifd.bin"
CONFIG_ME_BIN_PATH="binaries/me.bin"
CONFIG_GBE_BIN_PATH="binaries/gbe.bin"
CONFIG_HAVE_IFD_BIN=y
CONFIG_HAVE_ME_BIN=y
CONFIG_HAVE_GBE_BIN=y
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_BOOTSPLASH_FILE="/opt/coreboot/splash.bmp"
CONFIG_EDK2_FOLLOW_BGRT_SPEC=y
CONFIG_MAINBOARD_SMBIOS_PRODUCT_NAME="ThinkPad T480"
# thinkpad_acpi probes DMI product_version for the word "ThinkPad"; the
# default "1.0" makes it refuse to load (modprobe: "No such device").
CONFIG_MAINBOARD_VERSION="ThinkPad T480"
# vboot: the RO section verifies the signed RW slots A/B before jumping in
# (docs/vboot-notes.md). Layout comes from vboot.fmd (patch 0040); with
# FMDFILE set, CBFS_SIZE no longer shapes the layout.
CONFIG_VBOOT=y
CONFIG_FMDFILE="src/mainboard/lenovo/sklkbl_thinkpad/vboot.fmd"
# the SoC selects VBOOT_MUST_REQUEST_DISPLAY - without this, normal verified
# boots skip display init entirely (no splash, dark until the kernel)
CONFIG_VBOOT_ALWAYS_ENABLE_DISPLAY=y
# nothing else clears the recovery request with a non-vboot payload: the only
# other caller sits in the depthcharge path. Without this a single recovery
# event pins the machine to RO boots forever.
CONFIG_VBOOT_CLEAR_RECOVERY_IN_RAMSTAGE=y
# own signing keys from keys/ (never committed). Drop these four lines to fall
# back to the public vboot devkeys.
# Firmware version for rollback protection. futility puts it into the preamble
# of both slots; vboot combines it with the keyblock's key version into
# sd->fw_version and refuses anything strictly below the TPM counter. RAISE THIS
# BY ONE FOR EVERY RELEASE that fixes something worth locking out - the counter
# can never move without it. Raising it makes every older image unbootable once
# the counter has followed (scripts/vbnv.py boot-ok), backups included; the
# recovery path in WP_RO is not version-checked and always boots.
CONFIG_VBOOT_KEYBLOCK_VERSION=3
CONFIG_VBOOT_ROOT_KEY="/opt/keys/root_key.vbpubk"
CONFIG_VBOOT_RECOVERY_KEY="/opt/keys/recovery_key.vbpubk"
CONFIG_VBOOT_FIRMWARE_PRIVKEY="/opt/keys/firmware_data_key.vbprivk"
CONFIG_VBOOT_KEYBLOCK="/opt/keys/firmware.keyblock"
# SPI write protection for WP_RO (docs/vboot-notes.md). A PCH protected range
# register covers WP_RO exactly - 4 KB granularity; the chip's own BP bits only
# do power-of-two blocks and would round up to the top 8 MB, taking half of
# RW_SECTION_B with them. The range is sealed with FLOCKDN/DLOCK every boot and
# blocks every host write including SMM - independent of bios_lock, which only
# gates the regions outside it. SMMSTORE, the MRC cache and both RW slots stay
# writable (slot updates keep working internally); any WP_RO change - keyset,
# GBB, verstage, layout - needs the external programmer from now on.
# BOOTMEDIA_LOCK_IN_VERSTAGE stays off: it would lock before ramstage and its
# help text warns it blocks write-protect facilities there; everything running
# between verstage and the ramstage lock is verified code anyway.
CONFIG_BOOTMEDIA_LOCK_CONTROLLER=y
CONFIG_BOOTMEDIA_LOCK_WPRO_VBOOT_RO=y
# SMM BIOS write protection: flash writes only succeed from SMM, so flashrom
# from a running OS stops working while SMMSTORE (which goes through SMM) keeps
# working. The runtime option puts a "BIOS Lock" toggle into the setup menu
# (patch 0042) - turn it off, reboot, flash, turn it back on. The toggle lives
# in SMMSTORE, writable from the OS, so this is a tripwire against accidents
# and remote software, not a boundary against root. That boundary is the
# controller lock above.
CONFIG_BOOTMEDIA_SMM_BWP=y
CONFIG_BOOTMEDIA_SMM_BWP_RUNTIME_OPTION=y
# Flash descriptor: without this coreboot takes its default UNLOCK_FLASH_REGIONS
# and runs `ifdtool -u`, which hands the host write access to every region -
# descriptor, ME and GbE included, none of which SMM BWP or the WP_RO range
# cover (measured: a GbE write succeeds on a fully locked machine). Locking
# leaves the host read-only on the descriptor and shuts it out of ME writes;
# ALLOW_CPU_READ_ACCESS keeps ME readable so a full-chip backup still works.
# BIOS region stays read/write, so slot updates are unaffected. Note that
# ifdtool deliberately keeps GbE host-writable on this platform - changing the
# MAC keeps working, and that hole stays open (issue #5).
# One-way: after this the descriptor itself needs the external programmer.
CONFIG_LOCK_MANAGEMENT_ENGINE=y
CONFIG_ME_REGION_ALLOW_CPU_READ_ACCESS=y
CONFIG_SMMSTORE=y
CONFIG_SMMSTORE_V2=y
CONFIG_SMMSTORE_SIZE=0x40000
CONFIG_EDK2_SECURE_BOOT_SUPPORT=y
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D VARIABLE_SUPPORT=SMMSTORE"
# measure all stages/blobs into TPM PCR 2 before running them (log: cbmem -L)
CONFIG_TPM_MEASURED_BOOT=y
# (machine identity + optional devicetree devices live in config/board.conf)

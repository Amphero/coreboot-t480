tpm-reset: clear the TPM 2.0 via TPM2_Clear on every boot (T480 reset ROM)

Adds a ramstage BS_POST_DEVICE/BS_ON_ENTRY hook to the lenovo/sklkbl_thinkpad
(t480) board that runs tpm_setup(0) -> tlcl2_clear_control(false) ->
tlcl_force_clear(), i.e. TPM2_ClearControl + TPM2_Clear via the platform
hierarchy. Applied ONLY to the Reset-ROM produced by build-firmware.py's
--tpm-reset flag; the normal ROM is built without it.

Generic patch - verified to apply to coreboot pinned (2a2ab9e0) and latest (26.06).
---
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/Makefile.mk b/src/mainboard/lenovo/sklkbl_thinkpad/Makefile.mk
index eebe6f45..8d6c1c75 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/Makefile.mk
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/Makefile.mk
@@ -9,6 +9,7 @@ ramstage-$(CONFIG_VARIANT_HAS_DGPU) += dgpu.c
 ramstage-y += variants/$(VARIANT_DIR)/gpio.c
 ramstage-y += variants/$(VARIANT_DIR)/hda_verb.c
 ramstage-y += ramstage.c
+ramstage-y += tpm_reset_clear.c
 ramstage-$(CONFIG_MAINBOARD_USE_LIBGFXINIT) += variants/$(VARIANT_DIR)/gma-mainboard.ads
 
 subdirs-y += variants/$(VARIANT_DIR)
diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/tpm_reset_clear.c b/src/mainboard/lenovo/sklkbl_thinkpad/tpm_reset_clear.c
new file mode 100644
index 00000000..9426b7b3
--- /dev/null
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/tpm_reset_clear.c
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/*
+ * --tpm-reset - one-shot TPM 2.0 clear on every boot.
+ *
+ * Only in the reset ROM from build-firmware.py --tpm-reset; the normal ROM is
+ * built without it. Clears the T480's discrete TPM 2.0 on every ramstage boot,
+ * which recovers a TPM wedged by the vendor BIOS - "MFG mode", a set
+ * owner-auth, a latched disableClear.
+ *
+ * WARNING: TPM2_Clear is irreversible. It changes the storage and endorsement
+ * primary seeds and evicts every owner object, so anything sealed to the TPM
+ * (LUKS / BitLocker keys, attestation keys) is gone. This ROM clears on EVERY
+ * boot: boot it once, verify, reflash the normal ROM.
+ *
+ * Each step logs its rc and none is fatal - clearing must never hang the boot:
+ *
+ *   1. tpm_setup(0)             TSS init (tlcl_lib_init) plus TPM2_Startup.
+ *                               init_tpm_dev() already started the TPM this
+ *                               boot (BS_DEV_INIT/BS_ON_EXIT, via
+ *                               CONFIG_TPM_INIT_RAMSTAGE=y), so this returns
+ *                               TPM_INVALID_POSTINIT. Benign, normalised to
+ *                               success.
+ *   2. tlcl2_clear_control(false)  Undoes a latched disableClear. coreboot
+ *                               hardcodes ClearControl's disable field to 0
+ *                               and re-enables clear whatever is passed. No
+ *                               generic tlcl_* wrapper exists, so the TPM2
+ *                               entry point is called directly - the board is
+ *                               unconditionally TPM2 (MAINBOARD_HAS_TPM2).
+ *   3. tlcl_force_clear()       TPM2_Clear through the platform hierarchy
+ *                               (TPM_RH_PLATFORM). platformAuth is empty after
+ *                               TPM2_Startup(CLEAR), so firmware holds the
+ *                               authorisation: no owner or lockout auth, no
+ *                               physical presence (a no-op on coreboot's TPM2
+ *                               path anyway).
+ *
+ * BS_POST_DEVICE/BS_ON_ENTRY is the first step after BS_DEV_INIT/BS_ON_EXIT,
+ * where coreboot brings the TPM up - the TIS is live and the TPM started.
+ */
+
+#include <bootstate.h>
+#include <console/console.h>
+#include <security/tpm/tspi.h>
+#include <security/tpm/tss.h>
+#include <types.h>
+
+static void tpm_reset_clear(void *unused)
+{
+	tpm_result_t rc;
+
+	printk(BIOS_INFO,
+	       "TPM-RESET: one-shot TPM2_Clear starting - this firmware clears the TPM on EVERY boot\n");
+
+	/*
+	 * Step 1: make sure the TSS stack is initialised and the TPM is
+	 * started. A second TPM2_Startup this boot returns INVALID_POSTINIT,
+	 * which only means coreboot already started the TPM - treat as success.
+	 */
+	rc = tpm_setup(0);
+	if (rc == TPM_INVALID_POSTINIT) {
+		printk(BIOS_INFO,
+		       "TPM-RESET: step1 tpm_setup rc=%#x (INVALID_POSTINIT: TPM already started this boot - OK)\n",
+		       rc);
+		rc = TPM_SUCCESS;
+	} else {
+		printk(BIOS_INFO, "TPM-RESET: step1 tpm_setup rc=%#x\n", rc);
+	}
+
+	/* Step 2: re-enable clear (undo a possibly latched disableClear). */
+	rc = tlcl2_clear_control(false);
+	printk(BIOS_INFO, "TPM-RESET: step2 tlcl2_clear_control(false) rc=%#x\n", rc);
+
+	/* Step 3: the actual TPM2_Clear, via the platform hierarchy. */
+	rc = tlcl_force_clear();
+	printk(BIOS_INFO, "TPM-RESET: step3 tlcl_force_clear rc=%#x\n", rc);
+
+	if (rc == TPM_SUCCESS)
+		printk(BIOS_INFO,
+		       "TPM-RESET: done - TPM cleared. Shut down and reflash the normal ROM now.\n");
+	else
+		printk(BIOS_ERR,
+		       "TPM-RESET: FAILED (rc=%#x) - inspect the step codes above; booting anyway.\n",
+		       rc);
+}
+
+BOOT_STATE_INIT_ENTRY(BS_POST_DEVICE, BS_ON_ENTRY, tpm_reset_clear, NULL);

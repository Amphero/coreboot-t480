   return RETURN_SUCCESS;
 }
 
+//
+// coreboot's TPM2 log (src/security/tpm/tpm2_log_serialized.h). The entries
+// are TCG_PCR_EVENT2 structures with a single digest, reusable verbatim; the
+// vendor block carries the magic and the counts that make them safe to trust.
+//
+#pragma pack(1)
+typedef struct {
+  UINT32    PcrIndex;
+  UINT32    EventType;
+  UINT8     Digest[20];
+  UINT32    EventSize;
+  UINT8     Signature[16];
+  UINT32    PlatformClass;
+  UINT8     SpecVersionMinor;
+  UINT8     SpecVersionMajor;
+  UINT8     SpecErrata;
+  UINT8     UintnSize;
+  UINT32    NumberOfAlgorithms;
+  UINT16    DigestAlgId;
+  UINT16    DigestSize;
+  UINT8     VendorInfoSize;
+  UINT8     Reserved;
+  UINT8     VersionMajor;
+  UINT8     VersionMinor;
+  UINT32    Magic;
+  UINT16    MaxEntries;
+  UINT16    NumEntries;
+  UINT32    EntrySize;
+} CB_TPM2_LOG_HEADER;
+
+typedef struct {
+  UINT32    PcrIndex;
+  UINT32    EventType;
+  UINT32    DigestCount;
+  UINT16    DigestType;
+  UINT8     Digest[32];
+  UINT32    DataLength;
+  UINT8     Data[50];
+} CB_TPM2_LOG_ENTRY;
+#pragma pack()
+
+#define CB_TPM2_LOG_VI_MAGIC  0x32544243  // "CBT2"
+#define CB_TPM2_LOG_VI_MAJOR  1
+
+/**
+  Re-log the bootloader's TPM measurements as event hobs.
+
+  coreboot extends PCRs long before this payload runs, and Tcg2Dxe starts a
+  fresh event log that knows nothing about them - the exported log then fails
+  to reconstruct the PCRs. Tcg2Dxe already replays gTcgEvent2EntryHobGuid
+  hobs into its log before its own measurements, which is exactly the right
+  position, so all this has to do is translate the entries. The PCRs are not
+  touched - they already hold these digests.
+**/
+STATIC
+VOID
+BuildTpmEventLogHobs (
+  VOID
+  )
+{
+  RETURN_STATUS       Status;
+  UINT64              Address;
+  UINT32              Size;
+  CB_TPM2_LOG_HEADER  *Log;
+  CB_TPM2_LOG_ENTRY   *Entry;
+  VOID                *NewEntry;
+  UINTN               Index;
+
+  Status = ParseTpmLogInfo (&Address, &Size);
+  if (RETURN_ERROR (Status) || (Address == 0)) {
+    return;
+  }
+
+  if (Size < sizeof (CB_TPM2_LOG_HEADER)) {
+    return;
+  }
+
+  Log = (CB_TPM2_LOG_HEADER *)(UINTN)Address;
+
+  //
+  // The magic pins the layout; the counts and sizes bound the copy. A log in
+  // the bootloader's own non-TCG format has a different magic and is skipped.
+  //
+  if ((Log->Magic != CB_TPM2_LOG_VI_MAGIC) ||
+      (Log->VersionMajor != CB_TPM2_LOG_VI_MAJOR) ||
+      (Log->EntrySize != sizeof (CB_TPM2_LOG_ENTRY)) ||
+      (Log->NumEntries > Log->MaxEntries))
+  {
+    DEBUG ((DEBUG_INFO, "Bootloader TPM log not usable, magic %x\n", Log->Magic));
+    return;
+  }
+
+  if (sizeof (CB_TPM2_LOG_HEADER) + (UINT64)Log->NumEntries * sizeof (CB_TPM2_LOG_ENTRY) > Size) {
+    DEBUG ((DEBUG_ERROR, "Bootloader TPM log overruns its cbmem entry\n"));
+    return;
+  }
+
+  Entry = (CB_TPM2_LOG_ENTRY *)(Log + 1);
+  for (Index = 0; Index < Log->NumEntries; Index++, Entry++) {
+    NewEntry = BuildGuidHob (&gTcgEvent2EntryHobGuid, sizeof (*Entry));
+    ASSERT (NewEntry != NULL);
+    if (NewEntry == NULL) {
+      return;
+    }
+
+    CopyMem (NewEntry, Entry, sizeof (*Entry));
+  }
+
+  DEBUG ((DEBUG_INFO, "Re-logged %d bootloader TPM measurements\n", (UINT32)Log->NumEntries));
+}

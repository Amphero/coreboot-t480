+
+/**
+  Checks whether an image can be written, and says why when it cannot.
+
+  @param[in]  Image              The image.
+  @param[in]  ImageSize          Its size in bytes.
+  @param[out] ImageUpdatable     Whether it is usable.
+  @param[out] LastAttemptStatus  Detail for the ESRT.
+
+  @retval EFI_SUCCESS            The check ran; see ImageUpdatable.
+  @retval EFI_INVALID_PARAMETER  A parameter is NULL.
+**/
+EFI_STATUS
+EFIAPI
+FmpDeviceCheckImageWithStatus (
+  IN  CONST VOID  *Image,
+  IN  UINTN       ImageSize,
+  OUT UINT32      *ImageUpdatable,
+  OUT UINT32      *LastAttemptStatus
+  )
+{
+  EFI_STATUS  Status;
+  UINTN       BlockSize;
+
+  if ((Image == NULL) || (ImageUpdatable == NULL) || (LastAttemptStatus == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  *ImageUpdatable    = IMAGE_UPDATABLE_VALID;
+  *LastAttemptStatus = LAST_ATTEMPT_STATUS_SUCCESS;
+
+  Status = ResolveSlot ();
+  if (EFI_ERROR (Status)) {
+    *ImageUpdatable    = IMAGE_UPDATABLE_INVALID;
+    *LastAttemptStatus = LAST_ATTEMPT_STATUS_ERROR_UNSUCCESSFUL;
+    return EFI_SUCCESS;
+  }
+
+  //
+  // A slot is written whole. Anything else would leave it part new, part old,
+  // and vboot would reject the result on the next boot without saying why.
+  //
+  if (ImageSize != mSlotSize) {
+    DEBUG ((
+      DEBUG_ERROR,
+      "%a: image is %x bytes, a slot is %x\n",
+      __func__,
+      ImageSize,
+      mSlotSize
+      ));
+    *ImageUpdatable    = IMAGE_UPDATABLE_INVALID;
+    *LastAttemptStatus = LAST_ATTEMPT_STATUS_ERROR_INVALID_FORMAT;
+    return EFI_SUCCESS;
+  }
+
+  Status = SmmStoreLibGetBlockSize (&BlockSize);
+  if (EFI_ERROR (Status) || (BlockSize == 0) ||
+      (mSlotOffset % BlockSize != 0) || (mSlotSize % BlockSize != 0))
+  {
+    DEBUG ((DEBUG_ERROR, "%a: slot is not block aligned\n", __func__));
+    *ImageUpdatable    = IMAGE_UPDATABLE_INVALID;
+    *LastAttemptStatus = LAST_ATTEMPT_STATUS_ERROR_UNSUCCESSFUL;
+    return EFI_SUCCESS;
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+  Checks whether an image can be written.
+
+  @param[in]  Image           The image.
+  @param[in]  ImageSize       Its size in bytes.
+  @param[out] ImageUpdatable  Whether it is usable.
+
+  @retval EFI_SUCCESS  The check ran; see ImageUpdatable.
+**/
+EFI_STATUS
+EFIAPI
+FmpDeviceCheckImage (
+  IN  CONST VOID  *Image,
+  IN  UINTN       ImageSize,
+  OUT UINT32      *ImageUpdatable
+  )
+{
+  UINT32  LastAttemptStatus;
+
+  return FmpDeviceCheckImageWithStatus (
+           Image,
+           ImageSize,
+           ImageUpdatable,
+           &LastAttemptStatus
+           );
+}
+
+/**
+  Writes the image into the inactive slot.
+
+  Block by block, skipping blocks that already hold the wanted contents. A
+  failure part way through leaves the inactive slot broken - which is why it
+  is the inactive one.
+
+  @param[in]  Image              The image.
+  @param[in]  ImageSize          Its size in bytes.
+  @param[in]  VendorCode         Unused.
+  @param[in]  Progress           Called with a percentage, may be NULL.
+  @param[in]  CapsuleFwVersion   Unused.
+  @param[out] AbortReason        Unused.
+  @param[out] LastAttemptStatus  Detail for the ESRT.
+
+  @retval EFI_SUCCESS            The slot was written.
+  @retval EFI_INVALID_PARAMETER  A parameter is NULL.
+  @retval EFI_DEVICE_ERROR       A block could not be written.
+**/
+EFI_STATUS
+EFIAPI
+FmpDeviceSetImageWithStatus (
+  IN  CONST VOID                                     *Image,
+  IN  UINTN                                          ImageSize,
+  IN  CONST VOID                                     *VendorCode        OPTIONAL,
+  IN  EFI_FIRMWARE_MANAGEMENT_UPDATE_IMAGE_PROGRESS  Progress           OPTIONAL,
+  IN  UINT32                                         CapsuleFwVersion,
+  OUT CHAR16                                         **AbortReason,
+  OUT UINT32                                         *LastAttemptStatus
+  )
+{
+  EFI_STATUS   Status;
+  UINT32       Updatable;
+  UINTN        BlockSize;
+  UINTN        BlockCount;
+  UINTN        Block;
+  UINTN        FirstBlock;
+  UINTN        NumBytes;
+  CONST UINT8  *Next;
+  UINT8        *ReadBuffer;
+
+  if ((Image == NULL) || (LastAttemptStatus == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  Status = FmpDeviceCheckImageWithStatus (Image, ImageSize, &Updatable, LastAttemptStatus);
+  if (EFI_ERROR (Status) || (Updatable != IMAGE_UPDATABLE_VALID)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  Status = SmmStoreLibGetBlockSize (&BlockSize);
+  if (EFI_ERROR (Status)) {
+    *LastAttemptStatus = LAST_ATTEMPT_STATUS_ERROR_UNSUCCESSFUL;
+    return Status;
+  }
+
+  ReadBuffer = AllocatePool (BlockSize);
+  if (ReadBuffer == NULL) {
+    *LastAttemptStatus = LAST_ATTEMPT_STATUS_ERROR_INSUFFICIENT_RESOURCES;
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  //
+  // Block numbers count from the start of the medium, not of the slot,
+  // because full-flash access is what the SMI handler hands out.
+  //
+  FirstBlock = mSlotOffset / BlockSize;
+  BlockCount = mSlotSize / BlockSize;
+  Next       = (CONST UINT8 *)Image;
+
+  DEBUG ((
+    DEBUG_INFO,
+    "%a: writing %u blocks from block %u\n",
+    __func__,
+    (UINT32)BlockCount,
+    (UINT32)FirstBlock
+    ));
+
+  for (Block = 0; Block < BlockCount; Block++, Next += BlockSize) {
+    if (Progress != NULL) {
+      Progress ((Block * 100) / BlockCount);
+    }
+
+    //
+    // Erasing and writing a block that already matches would cost a flash
+    // cycle for nothing, and the two slots differ in only part of their
+    // contents most of the time.
+    //
+    NumBytes = BlockSize;
+    Status   = SmmStoreLibReadAnyBlock (FirstBlock + Block, 0, &NumBytes, ReadBuffer);
+    if (!EFI_ERROR (Status) && (NumBytes == BlockSize) &&
+        (CompareMem (ReadBuffer, Next, BlockSize) == 0))
+    {
+      continue;
+    }
+
+    Status = SmmStoreLibEraseAnyBlock (FirstBlock + Block);
+    if (EFI_ERROR (Status)) {
+      DEBUG ((
+        DEBUG_ERROR,
+        "%a: erasing block %u failed: %r\n",
+        __func__,
+        (UINT32)(FirstBlock + Block),
+        Status
+        ));
+      goto Failed;
+    }
+
+    NumBytes = BlockSize;
+    Status   = SmmStoreLibWriteAnyBlock (FirstBlock + Block, 0, &NumBytes, (UINT8 *)Next);
+    if (EFI_ERROR (Status) || (NumBytes != BlockSize)) {
+      DEBUG ((
+        DEBUG_ERROR,
+        "%a: writing block %u failed: %r\n",
+        __func__,
+        (UINT32)(FirstBlock + Block),
+        Status
+        ));
+      goto Failed;
+    }
+  }
+
+  if (Progress != NULL) {
+    Progress (100);
+  }
+
+  FreePool (ReadBuffer);
+
+  DEBUG ((DEBUG_INFO, "%a: slot written\n", __func__));
+
+  //
+  // The slot is good but nothing selects it yet. If this fails the image is
+  // still on the chip and `vbnv arm-update` from the OS finishes the job, so
+  // report it and let the caller see the update as failed rather than
+  // pretending a machine will boot something it will not.
+  //
+  Status = ArmTrialBoot ();
+  if (EFI_ERROR (Status)) {
+    *LastAttemptStatus = LAST_ATTEMPT_STATUS_ERROR_UNSUCCESSFUL;
+    return Status;
+  }
+
+  *LastAttemptStatus = LAST_ATTEMPT_STATUS_SUCCESS;
+  return EFI_SUCCESS;
+
+Failed:
+  FreePool (ReadBuffer);
+
+  //
+  // Outside a boot with a pending capsule the SMI handler refuses full-flash
+  // access and every block call comes back unsupported. Name that case, or
+  // the next person reads it as broken hardware.
+  //
+  if (Status == EFI_UNSUPPORTED) {
+    DEBUG ((
+      DEBUG_ERROR,
+      "%a: no full flash access - is a capsule pending this boot?\n",
+      __func__
+      ));
+  }
+
+  *LastAttemptStatus = LAST_ATTEMPT_STATUS_ERROR_UNSUCCESSFUL;
+  return EFI_DEVICE_ERROR;
+}
+
+/**
+  Writes the image into the inactive slot.
+
+  @param[in]  Image             The image.
+  @param[in]  ImageSize         Its size in bytes.
+  @param[in]  VendorCode        Unused.
+  @param[in]  Progress          Called with a percentage, may be NULL.
+  @param[in]  CapsuleFwVersion  Unused.
+  @param[out] AbortReason       Unused.
+
+  @retval EFI_SUCCESS  The slot was written.
+**/
+EFI_STATUS
+EFIAPI
+FmpDeviceSetImage (
+  IN  CONST VOID                                     *Image,
+  IN  UINTN                                          ImageSize,
+  IN  CONST VOID                                     *VendorCode        OPTIONAL,
+  IN  EFI_FIRMWARE_MANAGEMENT_UPDATE_IMAGE_PROGRESS  Progress           OPTIONAL,
+  IN  UINT32                                         CapsuleFwVersion,
+  OUT CHAR16                                         **AbortReason
+  )
+{
+  UINT32  LastAttemptStatus;
+
+  return FmpDeviceSetImageWithStatus (
+           Image,
+           ImageSize,
+           VendorCode,
+           Progress,
+           CapsuleFwVersion,
+           AbortReason,
+           &LastAttemptStatus
+           );
+}
+
+/**
+  Locks the firmware device against further writes.
+
+  Nothing to do. coreboot programmed its protected ranges before the payload
+  started and sealed them with FLOCKDN, and the write path here goes through
+  an SMI that is only open while a capsule is pending.
+
+  @retval EFI_SUCCESS  Always.
+**/
+EFI_STATUS
+EFIAPI
+FmpDeviceLock (
+  VOID
+  )
+{
+  return EFI_SUCCESS;
+}

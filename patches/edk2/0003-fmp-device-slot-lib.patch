+{
+  return EFI_UNSUPPORTED;
+}
+
+/**
+  Provide a firmware device specific method to detect and process a firmware
+  device.
+
+  @param[in]      Handle   Device handle for the firmware device.
+  @param[in, out] Context  Firmware device context.
+
+  @retval EFI_SUCCESS  The firmware device was detected.
+**/
+EFI_STATUS
+EFIAPI
+FmpDeviceSetContext (
+  IN EFI_HANDLE  Handle,
+  IN OUT VOID    **Context
+  )
+{
+  return EFI_SUCCESS;
+}
+
+/**
+  Returns the size of the firmware image, i.e. of one slot.
+
+  @param[out] Size  The size in bytes.
+
+  @retval EFI_SUCCESS            The size was returned.
+  @retval EFI_INVALID_PARAMETER  Size is NULL.
+  @retval EFI_NOT_FOUND          The slot could not be determined.
+**/
+EFI_STATUS
+EFIAPI
+FmpDeviceGetSize (
+  OUT UINTN  *Size
+  )
+{
+  EFI_STATUS  Status;
+
+  if (Size == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  Status = ResolveSlot ();
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  *Size = mSlotSize;
+  return EFI_SUCCESS;
+}
+
+/**
+  Returns the GUID identifying this firmware to the update stack.
+
+  @param[out] Guid  Pointer to the GUID.
+
+  @retval EFI_SUCCESS      The GUID was returned.
+  @retval EFI_UNSUPPORTED  The bootloader named none.
+**/
+EFI_STATUS
+EFIAPI
+FmpDeviceGetImageTypeIdGuidPtr (
+  OUT EFI_GUID  **Guid
+  )
+{
+  CONST FIRMWARE_INFO  *Info;
+
+  Info = GetFwInfo ();
+  if (Info == NULL) {
+    return EFI_UNSUPPORTED;
+  }
+
+  *Guid = (EFI_GUID *)&Info->Type;
+  return EFI_SUCCESS;
+}
+
+/**
+  Returns the attributes supported and set for this firmware device.
+
+  Resetting after an update is required: the written slot only becomes the
+  running one on a later boot.
+
+  @param[out] Supported  Attributes this device understands.
+  @param[out] Setting    Attributes currently in effect.
+
+  @retval EFI_SUCCESS            The attributes were returned.
+  @retval EFI_INVALID_PARAMETER  A parameter is NULL.
+**/
+EFI_STATUS
+EFIAPI
+FmpDeviceGetAttributes (
+  OUT UINT64  *Supported,
+  OUT UINT64  *Setting
+  )
+{
+  if ((Supported == NULL) || (Setting == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  *Supported = IMAGE_ATTRIBUTE_IMAGE_UPDATABLE |
+               IMAGE_ATTRIBUTE_RESET_REQUIRED |
+               IMAGE_ATTRIBUTE_IN_USE;
+  *Setting = *Supported;
+
+  return EFI_SUCCESS;
+}
+
+/**
+  Returns the lowest version the running firmware will accept.
+
+  @param[out] LowestSupportedVersion  The version.
+
+  @retval EFI_SUCCESS      The version was returned.
+  @retval EFI_UNSUPPORTED  The bootloader reported none.
+**/
+EFI_STATUS
+EFIAPI
+FmpDeviceGetLowestSupportedVersion (
+  OUT UINT32  *LowestSupportedVersion
+  )
+{
+  CONST FIRMWARE_INFO  *Info;
+
+  if (LowestSupportedVersion == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  Info = GetFwInfo ();
+  if (Info == NULL) {
+    return EFI_UNSUPPORTED;
+  }
+
+  *LowestSupportedVersion = Info->LowestSupportedVersion;
+  return EFI_SUCCESS;
+}
+
+/**
+  Returns the version of the running firmware as text.
+
+  The caller frees the string.
+
+  @param[out] VersionString  The version, or NULL on error.
+
+  @retval EFI_SUCCESS           The string was returned.
+  @retval EFI_UNSUPPORTED       The bootloader reported none.
+  @retval EFI_OUT_OF_RESOURCES  Allocation failed.
+**/
+EFI_STATUS
+EFIAPI
+FmpDeviceGetVersionString (
+  OUT CHAR16  **VersionString
+  )
+{
+  CONST FIRMWARE_INFO  *Info;
+  UINTN                Length;
+
+  if (VersionString == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  *VersionString = NULL;
+
+  Info = GetFwInfo ();
+  if (Info == NULL) {
+    return EFI_UNSUPPORTED;
+  }
+
+  Length = AsciiStrnLenS (Info->VersionStr, sizeof (Info->VersionStr));
+
+  *VersionString = AllocateZeroPool ((Length + 1) * sizeof (CHAR16));
+  if (*VersionString == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  AsciiStrToUnicodeStrS (Info->VersionStr, *VersionString, Length + 1);
+  return EFI_SUCCESS;
+}
+
+/**
+  Returns the version of the running firmware.
+
+  @param[out] Version  The version.
+
+  @retval EFI_SUCCESS      The version was returned.
+  @retval EFI_UNSUPPORTED  The bootloader reported none.
+**/
+EFI_STATUS
+EFIAPI
+FmpDeviceGetVersion (
+  OUT UINT32  *Version
+  )
+{
+  CONST FIRMWARE_INFO  *Info;
+
+  if (Version == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  Info = GetFwInfo ();
+  if (Info == NULL) {
+    return EFI_UNSUPPORTED;
+  }
+
+  *Version = Info->Version;
+  return EFI_SUCCESS;
+}

+/** @file
+  Firmware device services that update the inactive verified-boot slot.
+
+  UefiPayloadPkg's other FmpDeviceLib, FmpDeviceSmmLib, rewrites the whole
+  flash chip and therefore needs every flash protection lifted while it runs.
+  This one writes a single RW_SECTION and needs nothing unlocked: coreboot
+  programs its protected ranges at BS_DEV_RESOURCES and seals them there,
+  which is before capsules are parsed at BS_DEV_INIT, and those ranges cover
+  WP_RO, SI_DESC and SI_GBE while leaving the BIOS region writable. The slots
+  are in the BIOS region.
+
+  Where things are comes from gEfiFlashLayoutInfoHobGuid, which carries
+  coreboot's in-memory copy of the flash map and the offset of the CBFS that
+  was actually booted from. That offset falls inside exactly one RW_SECTION
+  and so names the running slot; the other one is the target. Reading vboot's
+  own state was the alternative and was rejected - vb2_shared_data is internal
+  and not an interface.
+
+  Writing only works during a boot where coreboot found a pending capsule.
+  Full-flash access through the SMI handler is latched once per boot from the
+  capsule count (smmstore_preprocess_cmd), so outside that the block calls
+  come back as unsupported. That is the intended flow, not a defect: fwupd
+  stages the capsule, the reboot makes coreboot find it, and the payload
+  applies it.
+
+  After a successful write the trial boot is armed in VBNV, so the next boot
+  runs the new image once and falls back on its own if it does not come up.
+  Reporting that it did come up stays with the OS - scripts/vbnv.py boot-ok -
+  because firmware cannot know it.
+
+  Copyright (c) 2026, Amphero.<BR>
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#include <PiDxe.h>
+#include <Guid/FirmwareInfoGuid.h>
+#include <Guid/SystemResourceTable.h>
+#include <Guid/FlashLayoutInfoGuid.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/FmpDeviceLib.h>
+#include <Library/HobLib.h>
+#include <Library/IoLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/SmmStoreLib.h>
+
+#define FMAP_SIGNATURE  "__FMAP__"
+#define FMAP_NAMELEN    32
+
+//
+// The vboot non-volatile block in CMOS. coreboot reads it from
+// CONFIG_VBOOT_VBNV_OFFSET + 14 (security/vboot/vbnv_cmos.c) and only falls
+// back to its flash copy when the block does not verify, so a write here is
+// what the next boot sees.
+//
+#define VBNV_CMOS_INDEX       0x34
+#define VBNV_BLOCK_SIZE       16
+#define VBNV_OFFS_HEADER      0
+#define VBNV_OFFS_BOOT        1
+#define VBNV_OFFS_BOOT2       7
+#define VBNV_OFFS_CRC         15
+#define VBNV_HEADER_MASK      0xc3
+#define VBNV_HEADER_SIGNATURE 0x40
+#define VBNV_BOOT_TRY_COUNT   0x0f
+#define VBNV_BOOT2_TRY_NEXT   0x08
+
+#define CMOS_INDEX_PORT  0x70
+#define CMOS_DATA_PORT   0x71
+
+#pragma pack(push, 1)
+typedef struct {
+  UINT32    Offset;
+  UINT32    Size;
+  UINT8     Name[FMAP_NAMELEN];
+  UINT16    Flags;
+} FMAP_AREA;
+
+typedef struct {
+  UINT8        Signature[8];
+  UINT8        VerMajor;
+  UINT8        VerMinor;
+  UINT64       Base;
+  UINT32       Size;
+  UINT8        Name[FMAP_NAMELEN];
+  UINT16       NAreas;
+  FMAP_AREA    Areas[];
+} FMAP;
+#pragma pack(pop)
+
+//
+// The slot this library writes: the one the running firmware did not boot
+// from. Resolved once, on first use.
+//
+STATIC BOOLEAN  mSlotResolved = FALSE;
+STATIC UINT32   mSlotOffset   = 0;
+STATIC UINT32   mSlotSize     = 0;
+STATIC BOOLEAN  mSlotIsB      = FALSE;
+
+/**
+  Return the firmware information coreboot passed up, or NULL.
+
+  The version reported to the FMP stack is the running firmware's. It is not
+  read from the flash, so it stays correct even when the inactive slot holds
+  something else.
+
+  @retval  Pointer to the information, or NULL when it is missing.
+**/
+STATIC
+CONST FIRMWARE_INFO *
+GetFwInfo (
+  VOID
+  )
+{
+  EFI_HOB_GUID_TYPE  *Hob;
+
+  Hob = GetFirstGuidHob (&gEfiFirmwareInfoHobGuid);
+  if (Hob == NULL) {
+    return NULL;
+  }
+
+  return (CONST FIRMWARE_INFO *)GET_GUID_HOB_DATA (Hob);
+}
+
+/**
+  Look up an area in the flash map by name.
+
+  @param[in]  Fmap   The map.
+  @param[in]  Name   Area name, NUL terminated.
+  @param[out] Area   The area found.
+
+  @retval  TRUE   The area exists.
+  @retval  FALSE  It does not.
+**/
+STATIC
+BOOLEAN
+FindArea (
+  IN  CONST FMAP   *Fmap,
+  IN  CONST CHAR8  *Name,
+  OUT CONST FMAP_AREA  **Area
+  )
+{
+  UINTN  Index;
+  UINTN  Length;
+
+  Length = AsciiStrLen (Name);
+  if (Length >= FMAP_NAMELEN) {
+    return FALSE;
+  }
+
+  for (Index = 0; Index < Fmap->NAreas; Index++) {
+    //
+    // Area names are padded with zeroes, so comparing the name plus its
+    // terminator is enough to rule out a longer name with the same prefix.
+    //
+    if (CompareMem (Fmap->Areas[Index].Name, Name, Length + 1) == 0) {
+      *Area = &Fmap->Areas[Index];
+      return TRUE;
+    }
+  }
+
+  return FALSE;
+}
+
+/**
+  Work out which slot to write, and remember it.
+
+  @retval  EFI_SUCCESS    mSlotOffset and mSlotSize are usable.
+  @retval  EFI_NOT_FOUND  The information needed is missing or inconsistent.
+**/
+STATIC
+EFI_STATUS
+ResolveSlot (
+  VOID
+  )
+{
+  EFI_HOB_GUID_TYPE        *Hob;
+  CONST FLASH_LAYOUT_INFO  *Layout;
+  CONST FMAP               *Fmap;
+  CONST FMAP_AREA          *SlotA;
+  CONST FMAP_AREA          *SlotB;
+  CONST FMAP_AREA          *Target;
+
+  if (mSlotResolved) {
+    return EFI_SUCCESS;
+  }
+
+  Hob = GetFirstGuidHob (&gEfiFlashLayoutInfoHobGuid);
+  if (Hob == NULL) {
+    DEBUG ((DEBUG_ERROR, "%a: no flash layout hob\n", __func__));
+    return EFI_NOT_FOUND;
+  }
+
+  Layout = (CONST FLASH_LAYOUT_INFO *)GET_GUID_HOB_DATA (Hob);
+
+  if (Layout->FmapAddress == 0) {
+    //
+    // Only the offset on the medium is known. Reading the map from flash
+    // would work but needs the same SMI access as writing, which is not
+    // available outside a capsule boot - so there would be nothing to gain.
+    //
+    DEBUG ((DEBUG_ERROR, "%a: bootloader kept no flash map in memory\n", __func__));
+    return EFI_NOT_FOUND;
+  }
+
+  Fmap = (CONST FMAP *)(UINTN)Layout->FmapAddress;
+  if (CompareMem (Fmap->Signature, FMAP_SIGNATURE, sizeof (Fmap->Signature)) != 0) {
+    DEBUG ((DEBUG_ERROR, "%a: no flash map at %lx\n", __func__, Layout->FmapAddress));
+    return EFI_NOT_FOUND;
+  }
+
+  if (!FindArea (Fmap, "RW_SECTION_A", &SlotA) ||
+      !FindArea (Fmap, "RW_SECTION_B", &SlotB))
+  {
+    DEBUG ((DEBUG_ERROR, "%a: no RW_SECTION_A/B - not a verified boot layout\n", __func__));
+    return EFI_NOT_FOUND;
+  }
+
+  //
+  // The CBFS that was booted from sits inside the running slot. Take the
+  // other one. Its own size is not the region size, so it is used to place
+  // the offset and nothing else.
+  //
+  if ((Layout->CbfsOffset >= SlotA->Offset) &&
+      (Layout->CbfsOffset < (UINT64)SlotA->Offset + SlotA->Size))
+  {
+    Target = SlotB;
+  } else if ((Layout->CbfsOffset >= SlotB->Offset) &&
+             (Layout->CbfsOffset < (UINT64)SlotB->Offset + SlotB->Size))
+  {
+    Target = SlotA;
+  } else {
+    DEBUG ((
+      DEBUG_ERROR,
+      "%a: booted cbfs at %lx is in neither slot\n",
+      __func__,
+      Layout->CbfsOffset
+      ));
+    return EFI_NOT_FOUND;
+  }
+
+  mSlotOffset   = Target->Offset;
+  mSlotSize     = Target->Size;
+  mSlotIsB      = (BOOLEAN)(Target == SlotB);
+  mSlotResolved = TRUE;
+
+  DEBUG ((
+    DEBUG_INFO,
+    "%a: will write %a at %x size %x\n",
+    __func__,
+    (Target == SlotA) ? "RW_SECTION_A" : "RW_SECTION_B",
+    mSlotOffset,
+    mSlotSize
+    ));
+
+  return EFI_SUCCESS;
+}
+
+/**
+  CRC-8 ITU, x^8 + x^2 + x + 1.
+
+  The same routine as vboot's vb2_crc8() and coreboot's crc8_vbnv(). The block
+  is rejected by both if this does not match, so it has to agree exactly.
+
+  @param[in] Data    The bytes.
+  @param[in] Length  How many.
+
+  @retval  The checksum.
+**/
+STATIC
+UINT8
+Crc8 (
+  IN CONST UINT8  *Data,
+  IN UINTN        Length
+  )
+{
+  UINT16  Crc;
+  UINTN   Index;
+  UINTN   Bit;
+
+  Crc = 0;
+  for (Index = 0; Index < Length; Index++) {
+    Crc ^= (UINT16)Data[Index] << 8;
+    for (Bit = 0; Bit < 8; Bit++) {
+      if ((Crc & 0x8000) != 0) {
+        Crc ^= 0x1070 << 3;
+      }
+
+      Crc <<= 1;
+    }
+  }
+
+  return (UINT8)(Crc >> 8);
+}
+
+/**
+  Point the next boot at the slot just written and give it one attempt.
+
+  vboot then marks that boot TRYING rather than trusting the previous one, so
+  the rollback counter cannot move until the new image reports success itself.
+  A slot that never comes up costs one boot and the machine returns to the old
+  one without help.
+
+  Refuses to touch a block that does not verify - a bad write here would cost
+  the vboot state, and the update has already succeeded at that point.
+
+  @retval EFI_SUCCESS       The next boot will try the new slot.
+  @retval EFI_DEVICE_ERROR  The block did not verify, before or after writing.
+**/
+STATIC
+EFI_STATUS
+ArmTrialBoot (
+  VOID
+  )
+{
+  UINT8  Block[VBNV_BLOCK_SIZE];
+  UINT8  Verify[VBNV_BLOCK_SIZE];
+  UINTN  Index;
+
+  for (Index = 0; Index < VBNV_BLOCK_SIZE; Index++) {
+    IoWrite8 (CMOS_INDEX_PORT, (UINT8)(VBNV_CMOS_INDEX + Index));
+    Block[Index] = IoRead8 (CMOS_DATA_PORT);
+  }
+
+  if (((Block[VBNV_OFFS_HEADER] & VBNV_HEADER_MASK) != VBNV_HEADER_SIGNATURE) ||
+      (Block[VBNV_OFFS_CRC] != Crc8 (Block, VBNV_OFFS_CRC)))
+  {
+    DEBUG ((DEBUG_ERROR, "%a: vbnv block does not verify, leaving it alone\n", __func__));
+    return EFI_DEVICE_ERROR;
+  }
+
+  if (mSlotIsB) {
+    Block[VBNV_OFFS_BOOT2] |= VBNV_BOOT2_TRY_NEXT;
+  } else {
+    Block[VBNV_OFFS_BOOT2] &= (UINT8)~VBNV_BOOT2_TRY_NEXT;
+  }
+
+  Block[VBNV_OFFS_BOOT] = (UINT8)((Block[VBNV_OFFS_BOOT] & ~VBNV_BOOT_TRY_COUNT) | 1);
+  Block[VBNV_OFFS_CRC]  = Crc8 (Block, VBNV_OFFS_CRC);
+
+  for (Index = 0; Index < VBNV_BLOCK_SIZE; Index++) {
+    IoWrite8 (CMOS_INDEX_PORT, (UINT8)(VBNV_CMOS_INDEX + Index));
+    IoWrite8 (CMOS_DATA_PORT, Block[Index]);
+  }
+
+  //
+  // Read it back. CMOS is a different device on a different bus and this is
+  // the last thing standing between a written slot and a machine that boots
+  // it, so a silent failure here is worth one more read.
+  //
+  for (Index = 0; Index < VBNV_BLOCK_SIZE; Index++) {
+    IoWrite8 (CMOS_INDEX_PORT, (UINT8)(VBNV_CMOS_INDEX + Index));
+    Verify[Index] = IoRead8 (CMOS_DATA_PORT);
+  }
+
+  if (CompareMem (Verify, Block, VBNV_BLOCK_SIZE) != 0) {
+    DEBUG ((DEBUG_ERROR, "%a: vbnv write did not stick\n", __func__));
+    return EFI_DEVICE_ERROR;
+  }
+
+  DEBUG ((DEBUG_INFO, "%a: next boot tries slot %a\n", __func__, mSlotIsB ? "B" : "A"));
+
+  return EFI_SUCCESS;
+}
+

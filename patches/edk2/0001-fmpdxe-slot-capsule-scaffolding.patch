@@ -538,6 +538,10 @@ INF ShellPkg/Application/Shell/Shell.inf
 INF MdeModulePkg/Universal/EsrtDxe/EsrtDxe.inf
 !endif
 
+!if $(SLOT_CAPSULE_SUPPORT) == TRUE
+INF FmpDevicePkg/FmpDxe/FmpDxe.inf

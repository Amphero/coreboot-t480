diff --git a/UefiPayloadPkg/UefiPayloadPkg.dsc b/UefiPayloadPkg/UefiPayloadPkg.dsc
index f8431d0..805f578 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.dsc
+++ b/UefiPayloadPkg/UefiPayloadPkg.dsc
@@ -63,6 +63,27 @@
   DEFINE CAPSULE_MAIN_FW_GUID         =
   DEFINE CAPSULE_EMBED_FMP_DXE        = FALSE
 
+  #
+  # Slot-only capsule updates.
+  #
+  # CAPSULE_SUPPORT builds FmpDxe to update the whole flash chip - embedded
+  # into the capsule or, with CAPSULE_EMBED_FMP_DXE=FALSE, in the firmware
+  # with FmpDeviceSmmLib - and therefore needs every flash protection
+  # lifted.  This one keeps FmpDxe in the firmware and pairs it with
+  # FmpDeviceSlotLib, which writes only the inactive vboot slot - the one
+  # region the protected ranges leave writable anyway.
+  #
+  # The two are mutually exclusive: they disagree about what FmpDxe is
+  # allowed to touch.
+  #
+  DEFINE SLOT_CAPSULE_SUPPORT         = FALSE
+
+!if $(SLOT_CAPSULE_SUPPORT) == TRUE
+  !if $(CAPSULE_SUPPORT) == TRUE
+    !error CAPSULE_SUPPORT and SLOT_CAPSULE_SUPPORT are mutually exclusive.
+  !endif
+!endif
+
   #
   # Crypto Support
   #
@@ -379,12 +400,22 @@
   UefiUsbLib|MdePkg/Library/UefiUsbLib/UefiUsbLib.inf
   UefiScsiLib|MdePkg/Library/UefiScsiLib/UefiScsiLib.inf
   OemHookStatusCodeLib|MdeModulePkg/Library/OemHookStatusCodeLibNull/OemHookStatusCodeLibNull.inf
-!if $(CAPSULE_SUPPORT) == TRUE
+!if $(CAPSULE_SUPPORT) == TRUE || $(SLOT_CAPSULE_SUPPORT) == TRUE
   CapsuleLib|MdeModulePkg/Library/DxeCapsuleLibFmp/DxeCapsuleLib.inf
+  !if $(SLOT_CAPSULE_SUPPORT) == TRUE
+  # Always text here, even with a bootsplash.  A capsule can be applied from
+  # a ProcessCapsules() call that runs before a GOP exists; the graphics
+  # library's first progress call fails there, and DxeCapsuleLib answers a
+  # failed first call by handing FmpDxe a NULL progress callback, which it
+  # rejects (PROGRESS_CALLBACK_ERROR, 0x1001).  The text library prints into
+  # the void and succeeds.
+  DisplayUpdateProgressLib|MdeModulePkg/Library/DisplayUpdateProgressLibText/DisplayUpdateProgressLibText.inf
+  !else
   # Use the graphics implementation for update progress.
   # BOOT_ON_FLASH_UPDATE initializes the graphics console before
   # processing capsules.
   DisplayUpdateProgressLib|MdeModulePkg/Library/DisplayUpdateProgressLibGraphics/DisplayUpdateProgressLibGraphics.inf
+  !endif
   # If there are no specific checks to do, null-library suffices
   CapsuleUpdatePolicyLib|FmpDevicePkg/Library/CapsuleUpdatePolicyLibNull/CapsuleUpdatePolicyLibNull.inf
   FmpAuthenticationLib|SecurityPkg/Library/FmpAuthenticationLibPkcs7/FmpAuthenticationLibPkcs7.inf
@@ -682,7 +713,7 @@
 !if $(PERFORMANCE_MEASUREMENT_ENABLE)
   PerformanceLib|MdeModulePkg/Library/DxePerformanceLib/DxePerformanceLib.inf
 !endif
-!if $(CAPSULE_SUPPORT) == TRUE
+!if $(CAPSULE_SUPPORT) == TRUE || $(SLOT_CAPSULE_SUPPORT) == TRUE
   CapsuleLib|MdeModulePkg/Library/DxeCapsuleLibFmp/DxeRuntimeCapsuleLib.inf
 !endif
 
@@ -756,7 +787,11 @@
   gEfiMdeModulePkgTokenSpaceGuid.PcdHiiOsRuntimeSupport|FALSE
   gEfiMdeModulePkgTokenSpaceGuid.PcdPciDegradeResourceForOptionRom|FALSE
   ## Whether capsules are allowed to persist across reset.
+!if $(SLOT_CAPSULE_SUPPORT) == TRUE
+  gEfiMdeModulePkgTokenSpaceGuid.PcdSupportUpdateCapsuleReset|TRUE
+!else
   gEfiMdeModulePkgTokenSpaceGuid.PcdSupportUpdateCapsuleReset|$(CAPSULE_SUPPORT)
+!endif
 
 
   #
@@ -824,7 +859,11 @@
   gEfiMdePkgTokenSpaceGuid.PcdMaximumUnicodeStringLength|1800000
 
   ## Whether FMP capsules are enabled.
+!if $(SLOT_CAPSULE_SUPPORT) == TRUE
+  gEfiMdeModulePkgTokenSpaceGuid.PcdCapsuleFmpSupport|TRUE
+!else
   gEfiMdeModulePkgTokenSpaceGuid.PcdCapsuleFmpSupport|$(CAPSULE_SUPPORT)
+!endif
   ## Whether embedded drivers in FMP capsules are supported (opt-in).
   gEfiMdeModulePkgTokenSpaceGuid.PcdCapsuleEmbeddedDriverSupport|FALSE
 
@@ -1260,6 +1299,20 @@
   MdeModulePkg/Universal/EsrtDxe/EsrtDxe.inf
 !endif
 
+!if $(SLOT_CAPSULE_SUPPORT) == TRUE
+  # Same driver, opposite arrangement: it stays in the firmware, so a capsule
+  # is applied by the running firmware instead of carrying its own updater.
+  FmpDevicePkg/FmpDxe/FmpDxe.inf {
+    <Defines>
+      FILE_GUID = $(CAPSULE_MAIN_FW_GUID)
+    <PcdsFixedAtBuild>
+      gFmpDevicePkgTokenSpaceGuid.PcdFmpDeviceImageIdName|L"System Firmware"
+      !include $(FMP_DEVICE_PKCS7_PCD_INC)
+    <LibraryClasses>
+      FmpDeviceLib|UefiPayloadPkg/Library/FmpDeviceSlotLib/FmpDeviceSlotLib.inf
+  }
+!endif
+
 
   MdeModulePkg/Universal/Metronome/Metronome.inf
   MdeModulePkg/Universal/WatchdogTimerDxe/WatchdogTimer.inf
diff --git a/UefiPayloadPkg/UefiPayloadPkg.fdf b/UefiPayloadPkg/UefiPayloadPkg.fdf
index e96c486..a1b7666 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.fdf
+++ b/UefiPayloadPkg/UefiPayloadPkg.fdf
@@ -549,6 +549,12 @@ INF  FILE_GUID = $(CAPSULE_MAIN_FW_GUID) FmpDevicePkg/FmpDxe/FmpDxe.inf
 INF MdeModulePkg/Universal/EsrtDxe/EsrtDxe.inf
 !endif
 
+!if $(SLOT_CAPSULE_SUPPORT) == TRUE
+# The dsc gives this component a FILE_GUID of its own, so the reference
+# here has to name it too or nothing is placed in the volume.
+INF FILE_GUID = $(CAPSULE_MAIN_FW_GUID) FmpDevicePkg/FmpDxe/FmpDxe.inf
+!endif
+
 !if $(UNIVERSAL_PAYLOAD) == TRUE
 !if $(SECURE_BOOT_ENABLE) == TRUE
 

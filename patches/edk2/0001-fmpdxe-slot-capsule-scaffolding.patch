diff --git a/UefiPayloadPkg/UefiPayloadPkg.dsc b/UefiPayloadPkg/UefiPayloadPkg.dsc
index b7568bb4d9..2a0a72822f 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.dsc
+++ b/UefiPayloadPkg/UefiPayloadPkg.dsc
@@ -60,6 +60,24 @@
   DEFINE CAPSULE_SUPPORT              = FALSE
   DEFINE CAPSULE_MAIN_FW_GUID         =
 
+  #
+  # Slot-only capsule updates.
+  #
+  # CAPSULE_SUPPORT builds FmpDxe to be embedded into a capsule, where it
+  # updates the whole flash chip and therefore needs every flash protection
+  # lifted.  This one keeps FmpDxe in the firmware instead and pairs it with
+  # FmpDeviceSlotLib, which writes only the inactive vboot slot - the one
+  # region the protected ranges leave writable anyway.
+  #
+  # The two are mutually exclusive: they disagree about where FmpDxe lives and
+  # what it is allowed to touch.
+  #
+  DEFINE SLOT_CAPSULE_SUPPORT         = FALSE
+
+!if $(CAPSULE_SUPPORT) == TRUE && $(SLOT_CAPSULE_SUPPORT) == TRUE
+  !error CAPSULE_SUPPORT and SLOT_CAPSULE_SUPPORT are mutually exclusive.
+!endif
+
   #
   # Crypto Support
   #
@@ -372,7 +390,7 @@
   UefiUsbLib|MdePkg/Library/UefiUsbLib/UefiUsbLib.inf
   UefiScsiLib|MdePkg/Library/UefiScsiLib/UefiScsiLib.inf
   OemHookStatusCodeLib|MdeModulePkg/Library/OemHookStatusCodeLibNull/OemHookStatusCodeLibNull.inf
-  !if $(CAPSULE_SUPPORT) == TRUE
+  !if $(CAPSULE_SUPPORT) == TRUE || $(SLOT_CAPSULE_SUPPORT) == TRUE
   CapsuleLib|MdeModulePkg/Library/DxeCapsuleLibFmp/DxeCapsuleLib.inf
   BmpSupportLib|MdeModulePkg/Library/BaseBmpSupportLib/BaseBmpSupportLib.inf
     !if $(BOOTSPLASH_IMAGE)
@@ -753,7 +771,11 @@
   gEfiMdeModulePkgTokenSpaceGuid.PcdHiiOsRuntimeSupport|FALSE
   gEfiMdeModulePkgTokenSpaceGuid.PcdPciDegradeResourceForOptionRom|FALSE
   ## Whether capsules are allowed to persist across reset.
+!if $(SLOT_CAPSULE_SUPPORT) == TRUE
+  gEfiMdeModulePkgTokenSpaceGuid.PcdSupportUpdateCapsuleReset|TRUE
+!else
   gEfiMdeModulePkgTokenSpaceGuid.PcdSupportUpdateCapsuleReset|$(CAPSULE_SUPPORT)
+!endif
 
 
   #
@@ -821,7 +843,11 @@
   gEfiMdePkgTokenSpaceGuid.PcdMaximumUnicodeStringLength|1800000
 
   ## Whether FMP capsules are enabled.
+!if $(SLOT_CAPSULE_SUPPORT) == TRUE
+  gEfiMdeModulePkgTokenSpaceGuid.PcdCapsuleFmpSupport|TRUE
+!else
   gEfiMdeModulePkgTokenSpaceGuid.PcdCapsuleFmpSupport|$(CAPSULE_SUPPORT)
+!endif
 
 !if $(VARIABLE_SUPPORT) == "EMU" || $(VARIABLE_SUPPORT) == "SMMSTORE" || $(VARIABLE_SUPPORT) == "SPI"
   ## User Authentication PCD
@@ -1256,6 +1282,20 @@
   MdeModulePkg/Universal/EsrtDxe/EsrtDxe.inf
 !endif
 
+!if $(SLOT_CAPSULE_SUPPORT) == TRUE
+  # Same driver, opposite arrangement: it stays in the firmware, so a capsule
+  # is applied by the running firmware instead of carrying its own updater.
+  FmpDevicePkg/FmpDxe/FmpDxe.inf {
+    <Defines>
+      FILE_GUID = $(CAPSULE_MAIN_FW_GUID)
+    <PcdsFixedAtBuild>
+      gFmpDevicePkgTokenSpaceGuid.PcdFmpDeviceImageIdName|L"System Firmware"
+      !include $(FMP_DEVICE_PKCS7_PCD_INC)
+    <LibraryClasses>
+      FmpDeviceLib|UefiPayloadPkg/Library/FmpDeviceSlotLib/FmpDeviceSlotLib.inf
+  }
+!endif
+
 
   MdeModulePkg/Universal/Metronome/Metronome.inf
   MdeModulePkg/Universal/WatchdogTimerDxe/WatchdogTimer.inf

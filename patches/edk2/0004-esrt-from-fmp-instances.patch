diff --git a/UefiPayloadPkg/UefiPayloadPkg.dsc b/UefiPayloadPkg/UefiPayloadPkg.dsc
index a85605407..e70a37177 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.dsc
+++ b/UefiPayloadPkg/UefiPayloadPkg.dsc
@@ -1311,6 +1311,13 @@
     <LibraryClasses>
       FmpDeviceLib|UefiPayloadPkg/Library/FmpDeviceSlotLib/FmpDeviceSlotLib.inf
   }
+  # ESRT rebuilt from the FMP instances at ReadyToBoot, LastAttemptStatus
+  # included - BlSupportDxe's static table carries none, so a failed update
+  # would be invisible to the OS. Installs nothing without an FMP instance.
+  # Reports as device, not system firmware: that would need our GUID in
+  # PcdSystemFmpCapsuleImageTypeIdGuid, and the dsc parser does not expand
+  # $(CAPSULE_MAIN_FW_GUID) inside a PCD value.
+  MdeModulePkg/Universal/EsrtFmpDxe/EsrtFmpDxe.inf
 !endif
 
 
diff --git a/UefiPayloadPkg/UefiPayloadPkg.fdf b/UefiPayloadPkg/UefiPayloadPkg.fdf
index 35c385d75..bd14a0ad4 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.fdf
+++ b/UefiPayloadPkg/UefiPayloadPkg.fdf
@@ -556,6 +556,7 @@ INF MdeModulePkg/Universal/EsrtDxe/EsrtDxe.inf
 # The dsc gives this component a FILE_GUID of its own, so the reference
 # here has to name it too or nothing is placed in the volume.
 INF FILE_GUID = $(CAPSULE_MAIN_FW_GUID) FmpDevicePkg/FmpDxe/FmpDxe.inf
+INF MdeModulePkg/Universal/EsrtFmpDxe/EsrtFmpDxe.inf
 !endif
 
 !if $(UNIVERSAL_PAYLOAD) == TRUE

diff --git a/SecurityPkg/Tcg/Tcg2Dxe/Tcg2Dxe.c b/SecurityPkg/Tcg/Tcg2Dxe/Tcg2Dxe.c
index 5379cd9654..1c1f429247 100644
--- a/SecurityPkg/Tcg/Tcg2Dxe/Tcg2Dxe.c
+++ b/SecurityPkg/Tcg/Tcg2Dxe/Tcg2Dxe.c
@@ -2898,6 +2898,24 @@ DriverEntry (
     ASSERT_EFI_ERROR (Status);
   }
 
+  //
+  // Tcg2Pei would also have brought the TPM's bank allocation in line with
+  // the mask (SyncPcrAllocationsAndPcrMask). Without that step banks nobody
+  // extends stay active and poison the event log: the SpecID header lists
+  // every active bank, the replayed bootloader events carry SHA256 only,
+  // and the OS-side parsers stop at the first event whose digest count
+  // differs from the header's algorithm count. Reallocate to the mask; the
+  // allocation takes effect at the next TPM startup, so this boot continues
+  // on the old banks and the next one comes up clean. Deliberately no reset
+  // here: if the allocation does not stick, boot must not turn into a
+  // reset loop.
+  //
+  Tpm2PcrMask &= TpmHashAlgorithmBitmap;
+  if ((Tpm2PcrMask != 0) && (ActivePCRBanks != Tpm2PcrMask)) {
+    Status = Tpm2PcrAllocateBanks (NULL, TpmHashAlgorithmBitmap, Tpm2PcrMask);
+    DEBUG ((DEBUG_INFO, "Tpm2PcrAllocateBanks 0x%x -> 0x%x - %r\n", ActivePCRBanks, Tpm2PcrMask, Status));
+  }
+
   if (mTcgDxeData.BsCap.TPMPresentFlag) {
     //
     // Setup the log area and copy event log from hob list to it
diff --git a/UefiPayloadPkg/UefiPayloadPkg.dsc b/UefiPayloadPkg/UefiPayloadPkg.dsc
index b7568bb4d9..6481aa8201 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.dsc
+++ b/UefiPayloadPkg/UefiPayloadPkg.dsc
@@ -1061,6 +1061,12 @@
   gEfiSecurityPkgTokenSpaceGuid.PcdTpmInitializationPolicy|0
   ## Match the hash algorithms listed in Tcg2Dxe
   gEfiSecurityPkgTokenSpaceGuid.PcdTcg2HashAlgorithmBitmap|0x1F
+  ## SHA256 only.  The bootloader measures SHA256 and nothing else; every
+  ## further active bank is advertised in the event log header while the
+  ## replayed bootloader events carry a single digest, and the OS log
+  ## parsers stop at that mismatch.  Tcg2Dxe reallocates the TPM's banks
+  ## to this mask when they differ.
+  gEfiSecurityPkgTokenSpaceGuid.PcdTpm2HashMask|0x00000002
   gEfiSecurityPkgTokenSpaceGuid.PcdTpmPhysicalPresence|TRUE
 
 !include NetworkPkg/NetworkDynamicPcds.dsc.inc
@@ -1497,11 +1503,10 @@
       Tpm2DeviceLib|SecurityPkg/Library/Tpm2DeviceLibRouter/Tpm2DeviceLibRouterDxe.inf
       NULL|SecurityPkg/Library/Tpm2DeviceLibDTpm/Tpm2InstanceLibDTpm.inf
       HashLib|SecurityPkg/Library/HashLibBaseCryptoRouter/HashLibBaseCryptoRouterDxe.inf
-      NULL|SecurityPkg/Library/HashInstanceLibSha1/HashInstanceLibSha1.inf
+      # SHA256 only - the router rebuilds PcdTcg2HashAlgorithmBitmap from the
+      # registered instances, and every registered algorithm ends up in the
+      # event log header.  See PcdTpm2HashMask above.
       NULL|SecurityPkg/Library/HashInstanceLibSha256/HashInstanceLibSha256.inf
-      NULL|SecurityPkg/Library/HashInstanceLibSha384/HashInstanceLibSha384.inf
-      NULL|SecurityPkg/Library/HashInstanceLibSha512/HashInstanceLibSha512.inf
-      NULL|SecurityPkg/Library/HashInstanceLibSm3/HashInstanceLibSm3.inf
   }

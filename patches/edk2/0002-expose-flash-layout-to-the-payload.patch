diff --git a/UefiPayloadPkg/Include/Guid/FlashLayoutInfoGuid.h b/UefiPayloadPkg/Include/Guid/FlashLayoutInfoGuid.h
new file mode 100644
index 0000000000..fb97c92126
--- /dev/null
+++ b/UefiPayloadPkg/Include/Guid/FlashLayoutInfoGuid.h
@@ -0,0 +1,36 @@
+/** @file
+  Hob structure describing where things sit on the boot medium, for payload
+  components that write to it.
+
+  Copyright (c) 2026, Amphero.<BR>
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#pragma once
+
+///
+/// Flash layout information GUID
+///
+extern EFI_GUID  gEfiFlashLayoutInfoHobGuid;
+
+typedef struct {
+  ///
+  /// Address of the bootloader's in-memory copy of the flash map. coreboot
+  /// keeps one in CBMEM unconditionally and points at it with CB_TAG_FMAP,
+  /// so a consumer does not have to read or search the flash itself.
+  ///
+  UINT64    FmapAddress;
+  ///
+  /// Where that map lives on the medium, and how big the medium is.
+  ///
+  UINT64    FmapOffset;
+  UINT64    BootMediaSize;
+  ///
+  /// The CBFS the bootloader actually booted from. Under verified boot this
+  /// identifies the running slot without having to parse vboot's own state,
+  /// whose layout is not a stable interface.
+  ///
+  UINT64    CbfsOffset;
+  UINT64    CbfsSize;
+} FLASH_LAYOUT_INFO;

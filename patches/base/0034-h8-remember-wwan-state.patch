diff --git a/src/ec/lenovo/h8/Kconfig b/src/ec/lenovo/h8/Kconfig
index b6ca296b..e11cdf38 100644
--- a/src/ec/lenovo/h8/Kconfig
+++ b/src/ec/lenovo/h8/Kconfig
@@ -125,6 +125,15 @@ config H8_BLUETOOTH_KEEP_STATE
 	  being forced to the option value, so a radio the OS switched off
 	  through HKEY.SBDC stays off across a reboot.
 
+config H8_WWAN_KEEP_STATE
+	bool
+	default n
+	help
+	  Give the "wwan" option a third value, "Last state", and make it the
+	  default. The EC bit is then left untouched at boot instead of being
+	  forced to the option value, so a radio the OS switched off through
+	  HKEY.SWAN stays off across a reboot.
+
 config H8_FAN_STEPPED
 	bool
 	default n
diff --git a/src/ec/lenovo/h8/cfr.c b/src/ec/lenovo/h8/cfr.c
index b70bd3d8..eec19179 100644
--- a/src/ec/lenovo/h8/cfr.c
+++ b/src/ec/lenovo/h8/cfr.c
@@ -177,15 +177,36 @@ static const struct sm_object wlan = SM_DECLARE_BOOL({
 static void update_wwan(struct sm_object *new)
 {
 	if (!h8_has_wwan())
+#if CONFIG(H8_WWAN_KEEP_STATE)
+		new->sm_enum.flags = CFR_OPTFLAG_SUPPRESS;
+#else
 		new->sm_bool.flags = CFR_OPTFLAG_SUPPRESS;
+#endif
 }
 
+#if CONFIG(H8_WWAN_KEEP_STATE)
+static const struct sm_object wwan = SM_DECLARE_ENUM({
+	.opt_name	= "wwan",
+	.ui_name	= "WWAN",
+	.ui_helptext	= "Enable or disable the WWAN module. \"Last state\" "
+			  "leaves the radio the way the OS left it, so "
+			  "switching it off survives a reboot.",
+	.default_value	= H8_WWAN_LAST_STATE,
+	.values		= (const struct sm_enum_value[]) {
+		{ "Disabled",	0 },
+		{ "Enabled",	1 },
+		{ "Last state",	H8_WWAN_LAST_STATE },
+		SM_ENUM_VALUE_END
+	},
+}, WITH_CALLBACK(update_wwan));
+#else
 static const struct sm_object wwan = SM_DECLARE_BOOL({
 	.opt_name	= "wwan",
 	.ui_name	= "WWAN",
 	.ui_helptext	= "Enable or disable the WWAN module",
 	.default_value	= true,
 }, WITH_CALLBACK(update_wwan));
+#endif
 
 /* Power Management Beeps */
 static void update_beep(struct sm_object *new)
diff --git a/src/ec/lenovo/h8/h8.c b/src/ec/lenovo/h8/h8.c
index 99a16f5b..97a587af 100644
--- a/src/ec/lenovo/h8/h8.c
+++ b/src/ec/lenovo/h8/h8.c
@@ -426,8 +426,10 @@ static void h8_enable(struct device *dev)
 		h8_bluetooth_enable(val);
 	}
 
-	val = h8_has_wwan() && h8_wwan_nv_enable();
-	h8_wwan_enable(val);
+	if (!h8_wwan_nv_keep_state()) {

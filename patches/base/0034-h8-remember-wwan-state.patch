diff --git a/src/ec/lenovo/h8/wwan.c b/src/ec/lenovo/h8/wwan.c
index edb76659..4df284c9 100644
--- a/src/ec/lenovo/h8/wwan.c
+++ b/src/ec/lenovo/h8/wwan.c
@@ -48,3 +48,18 @@ bool h8_wwan_nv_enable(void)
 {
 	return get_uint_option("wwan", true);
 }
+
+/*
+ * Is the option set to "Last state"? The EC keeps register 0x3a across a
+ * reset, so not writing it leaves the radio the way the OS left it - that
+ * is the only way an OS-side "wwan off" survives a reboot, coreboot has
+ * no other memory of it.
+ */
+bool h8_wwan_nv_keep_state(void)
+{
+	if (!CONFIG(H8_WWAN_KEEP_STATE))
+		return false;
+
+	return get_uint_option("wwan", H8_WWAN_LAST_STATE) ==
+		H8_WWAN_LAST_STATE;
+}

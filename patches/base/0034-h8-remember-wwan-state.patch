 bool h8_bluetooth_nv_keep_state(void);
 bool h8_has_bdc(void);
 
+/* Third value of the "wwan" option, see H8_WWAN_KEEP_STATE */
+#define H8_WWAN_LAST_STATE 2
+
 void h8_wwan_enable(int on);
 bool h8_wwan_nv_enable(void);
+bool h8_wwan_nv_keep_state(void);

diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/devicetree.cb b/src/mainboard/lenovo/sklkbl_thinkpad/devicetree.cb
--- a/src/mainboard/lenovo/sklkbl_thinkpad/devicetree.cb
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/devicetree.cb
@@ -8,6 +8,19 @@
         register "PmConfigSlpSusMinAssert" = "3"        # 500ms
         register "PmConfigSlpAMinAssert" = "3"          # 2s
 
+	# Acoustic noise mitigation for issue #10 - a whine that tracks cpu
+	# load. The board sets none of these, so the FSP defaults apply.
+	#
+	# Only the IA rail is slowed. The whine follows cpu load, so IA is the
+	# suspect; an earlier build that also took GT to Fast/16 and disabled
+	# fast package-C ramping on all three rails made the screen flicker
+	# badly (measured 2026-08-29, docs/hda-notes.md).
+	#
+	# Note the unset registers are not "left alone": once mitigation is on
+	# they are passed as 0, which is Fast/2, not the pre-mitigation default.
+	register "AcousticNoiseMitigation" = "1"
+	register "SlowSlewRateForIa" = "3"		# Fast/16
+
 	# Generate ACPI P-State table
 	register "eist_enable" = "true"
 	device domain 0 on

diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/devicetree.cb b/src/mainboard/lenovo/sklkbl_thinkpad/devicetree.cb
--- a/src/mainboard/lenovo/sklkbl_thinkpad/devicetree.cb
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/devicetree.cb
@@ -8,6 +8,19 @@
         register "PmConfigSlpSusMinAssert" = "3"        # 500ms
         register "PmConfigSlpAMinAssert" = "3"          # 2s
 
+	# Acoustic noise mitigation. The T480 sets none of these, so the FSP
+	# defaults apply: fast VR slew rates and fast package-C ramping, which
+	# is what makes the rails audible under changing load. Diagnostic
+	# values - the most aggressive the UPDs allow, to be tuned down to
+	# whatever still works. See docs/hda-notes.md and issue #10.
+	register "AcousticNoiseMitigation" = "1"
+	register "SlowSlewRateForIa" = "3"		# Fast/16
+	register "SlowSlewRateForGt" = "3"		# Fast/16
+	register "SlowSlewRateForSa" = "3"		# Fast/16
+	register "FastPkgCRampDisableIa" = "1"
+	register "FastPkgCRampDisableGt" = "1"
+	register "FastPkgCRampDisableSa" = "1"
+
 	# Generate ACPI P-State table
 	register "eist_enable" = "true"
 	device domain 0 on

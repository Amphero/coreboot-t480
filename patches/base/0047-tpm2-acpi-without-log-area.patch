diff --git a/src/security/tpm/Kconfig b/src/security/tpm/Kconfig
index a53163d..58b0402 100644
--- a/src/security/tpm/Kconfig
+++ b/src/security/tpm/Kconfig
@@ -170,6 +170,16 @@ config PCR_RUNTIME_DATA
 	int
 	default 3
 
+config TPM2_ACPI_NO_LOG_AREA
+	bool "Leave the event log out of the TPM2 ACPI table"
+	depends on TPM2 && TPM_MEASURED_BOOT && HAVE_ACPI_TABLES
+	help
+	  Do not fill LASA/LAML in the TPM2 ACPI table. Linux reads the log
+	  the ACPI table points at in preference to the EFI event log, so a
+	  payload that re-publishes the measurements in its own TCG2 log
+	  needs the ACPI reference gone for the complete log to win. The log
+	  itself stays in CBMEM either way (cbmem -L).
+

diff --git a/src/ec/lenovo/h8/Kconfig b/src/ec/lenovo/h8/Kconfig
index cbc3d559..2e513172 100644
--- a/src/ec/lenovo/h8/Kconfig
+++ b/src/ec/lenovo/h8/Kconfig
@@ -116,6 +116,16 @@ config H8_EXTENDED_HOTKEYS
 	  Lenovo hotkey codes (0x11xx/0x13xx) the kernel expects, instead
 	  of legacy codes that map to KEY_UNKNOWN or generic KEY_FN_*.
 
+config H8_KB_BACKLIGHT_OPTIONAL
+	bool
+	default n
+	help
+	  Add a "kb_backlight_installed" option. The T480 ships with and
+	  without a backlit keyboard and the devicetree cannot tell them
+	  apart, so a machine without one still gets HKBL published and
+	  thinkpad_acpi creates a kbd_backlight LED for nothing. Turning the
+	  option off hides the backlight from the OS.
+
 config H8_BLUETOOTH_KEEP_STATE
 	bool
 	default n
diff --git a/src/ec/lenovo/h8/cfr.c b/src/ec/lenovo/h8/cfr.c
index eec19179..cfaa4816 100644
--- a/src/ec/lenovo/h8/cfr.c
+++ b/src/ec/lenovo/h8/cfr.c
@@ -101,6 +101,18 @@ static void update_backlight(struct sm_object *new)
 	new->sm_enum.default_value = h8_illumination_default();
 }
 
+#if CONFIG(H8_KB_BACKLIGHT_OPTIONAL)
+/* Hardware presence, not a setting: see H8_KB_BACKLIGHT_OPTIONAL */
+static const struct sm_object kb_backlight_installed = SM_DECLARE_BOOL({
+	.opt_name	= "kb_backlight_installed",
+	.ui_name	= "Keyboard backlight installed",
+	.ui_helptext	= "Turn this off on a keyboard without backlight. The "
+			  "OS then sees no backlight at all instead of a "
+			  "control that does nothing.",
+	.default_value	= true,
+});
+#endif
+
 /* Illumination Control (ThinkLight and/or keyboard backlight) */
 static const struct sm_object backlight = SM_DECLARE_ENUM({
 	.opt_name	= "backlight",
@@ -298,6 +310,9 @@ __cfr_form static struct sm_obj_form cfr_hid = {
 	.ui_name = "Keyboard/Mouse",
 	.obj_list = (const struct sm_object *[]) {
 		&backlight,
+#if CONFIG(H8_KB_BACKLIGHT_OPTIONAL)
+		&kb_backlight_installed,
+#endif
 		&fn_ctrl_swap,
 		&sticky_fn,
 		&f1_to_f12_as_primary,
diff --git a/src/ec/lenovo/h8/ssdt.c b/src/ec/lenovo/h8/ssdt.c
index fbe7070d..7aa01677 100644
--- a/src/ec/lenovo/h8/ssdt.c
+++ b/src/ec/lenovo/h8/ssdt.c
@@ -2,6 +2,7 @@
 
 #include <console/console.h>
 #include <acpi/acpigen.h>
+#include <option.h>
 #include <stdio.h>
 #include <string.h>
 
@@ -36,7 +37,9 @@ void h8_ssdt_generator(const struct device *dev)
 	acpigen_write_name_byte("HBDC", h8_has_bdc() ? ONE_OP : ZERO_OP);
 	acpigen_write_name_byte("HWAN", h8_has_wwan() ? ONE_OP : ZERO_OP);
 	acpigen_write_name_byte("HKLT", h8_thinklight_active() ? ONE_OP : ZERO_OP);
-	acpigen_write_name_byte("HKBL", h8_kb_backlight_active() ? ONE_OP : ZERO_OP);
+	acpigen_write_name_byte("HKBL", (h8_kb_backlight_active() &&
+			(!CONFIG(H8_KB_BACKLIGHT_OPTIONAL) ||
+			 get_uint_option("kb_backlight_installed", 1))) ? ONE_OP : ZERO_OP);
 	acpigen_write_name_byte("HUWB", h8_has_uwb() ? ONE_OP : ZERO_OP);
 
 	acpigen_pop_len(); /* Scope HKEY */

diff --git a/src/drivers/efi/Kconfig b/src/drivers/efi/Kconfig
index 22fee4fb..72d406d3 100644
--- a/src/drivers/efi/Kconfig
+++ b/src/drivers/efi/Kconfig
@@ -58,6 +58,20 @@ config DRIVERS_EFI_UPDATE_CAPSULES
 	  to discover firmware updates and expose them for tianocore thorough
 	  CBMEM for execution.  tianocore is responsible for erasing the variables.
 
+config DRIVERS_EFI_CAPSULE_SLOT_UPDATE
+	bool "Apply capsules to the inactive vboot slot"
+	depends on PAYLOAD_EDK2 && DRIVERS_EFI_UPDATE_CAPSULES && VBOOT_SLOTS_RW_AB
+	help
+	  Build the payload so that it keeps FmpDxe in the firmware and updates
+	  only the inactive RW slot, instead of embedding FmpDxe into the capsule
+	  where it rewrites the whole chip.
+
+	  The upstream arrangement needs every flash protection lifted while it
+	  runs. This one does not: the slots sit in the BIOS region, which the
+	  protected ranges leave writable.
+
+	  Needs a payload that provides SLOT_CAPSULE_SUPPORT.
+
 config DRIVERS_EFI_CAPSULE_ON_DISK_SUPPORT
 	bool "Support EFI capsules on disk"
 	depends on DRIVERS_EFI_UPDATE_CAPSULES

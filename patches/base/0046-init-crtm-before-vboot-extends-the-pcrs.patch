diff --git a/src/security/vboot/vboot_logic.c b/src/security/vboot/vboot_logic.c
index f98b083..534f812 100644
--- a/src/security/vboot/vboot_logic.c
+++ b/src/security/vboot/vboot_logic.c
@@ -187,6 +187,19 @@ static vb2_error_t hash_body(struct vb2_context *ctx,
 static tpm_result_t extend_pcrs(struct vb2_context *ctx)
 {
 	tpm_result_t rc;
+
+	/*
+	 * The first CBFS measurement initializes the CRTM lazily, and that
+	 * initialization clears the pre-RAM log. With vboot starting in the
+	 * bootblock it happens after this function, throwing away the three
+	 * entries logged here. Initialize the CRTM first instead.
+	 */
+	if (CONFIG(TPM_MEASURED_BOOT)) {
+		rc = tspi_ensure_crtm();
+		if (rc)
+			return rc;
+	}
+
 	rc = vboot_extend_pcr(ctx, CONFIG_PCR_BOOT_MODE, BOOT_MODE_PCR);
 	if (rc)
 		return rc;

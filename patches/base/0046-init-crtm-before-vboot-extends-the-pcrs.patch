+/**
+ * Initialize the CRTM unless that already happened. Code that logs TPM
+ * measurements before the first CBFS measurement of its stage has to call
+ * this first: initialization clears the pre-RAM log, and the first CBFS
+ * measurement triggers it lazily, wiping every entry logged before it.
+ */
+tpm_result_t tspi_ensure_crtm(void);

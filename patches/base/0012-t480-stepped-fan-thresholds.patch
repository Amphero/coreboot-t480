+++ b/src/mainboard/lenovo/sklkbl_thinkpad/acpi/ec.asl
@@ -4,9 +4,20 @@
 #define BRIGHTNESS_DOWN \_SB.PCI0.GFX0.DECB
 #define THINKPAD_EC_GPE 22
 
-Name(\TCRT, 100)
+/*
+ * 110, not the CPU's 100: at 100 the CPU merely throttles (PROCHOT), so
+ * the EC sensor cannot exceed it while thermal management works - a trip
+ * AT 100 turns a harmless boost transient into a hardware-protection
+ * poweroff (observed under an all-core build). 110 is only reachable
+ * when throttling itself has failed, which is what _CRT is for.
+ */
+Name(\TCRT, 110)
 Name(\TPSV, 90)
 Name(\FLVL, 0)
 
+#if CONFIG(H8_FAN_STEPPED)
+#include <variant/thermal.h>
+#endif
+
 #include <ec/lenovo/h8/acpi/ec.asl>
 #include <ec/lenovo/h8/acpi/thinkpad_bat_thresholds_b0.asl>

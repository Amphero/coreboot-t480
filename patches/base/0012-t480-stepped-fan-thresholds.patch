+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef VARIANT_THERMAL_H
+#define VARIANT_THERMAL_H
+
+/*
+ * Stepped fan control (H8_FAN_STEPPED), see ec/lenovo/h8/acpi/thermal.asl.
+ *
+ * HFSP values: 0x80 = EC automatic, 0x01-0x07 = fixed regulated level.
+ * Level 4 is the resting state and MUST stay 0x80 so the EC curve remains
+ * active as a safety net (0x00 would mean fan off with the curve disabled).
+ */
+#define FAN4_HFSP		0x80	/* resting state - EC automatic */
+#define FAN3_HFSP		0x02
+#define FAN2_HFSP		0x04
+#define FAN1_HFSP		0x06
+#define FAN0_HFSP		0x07	/* fastest REGULATED level */
+
+/*
+ * Trip points in degrees C, 8 K hysteresis each. _AC0 belongs to the
+ * FASTEST level (ACPI defines it that way). Keep every value well below
+ * \TCRT (100) - the critical shutdown is the last resort, not part of
+ * the fan curve.
+ */
+#define FAN0_THRESHOLD_ON	85
+#define FAN0_THRESHOLD_OFF	77
+#define FAN1_THRESHOLD_ON	76
+#define FAN1_THRESHOLD_OFF	68
+#define FAN2_THRESHOLD_ON	68
+#define FAN2_THRESHOLD_OFF	60
+#define FAN3_THRESHOLD_ON	58
+#define FAN3_THRESHOLD_OFF	50
+
+#endif /* VARIANT_THERMAL_H */

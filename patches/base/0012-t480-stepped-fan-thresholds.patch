+++ b/src/mainboard/lenovo/sklkbl_thinkpad/variants/t480/include/variant/thermal.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef VARIANT_THERMAL_H
+#define VARIANT_THERMAL_H
+
+/*
+ * Stepped fan control (H8_FAN_STEPPED), see ec/lenovo/h8/acpi/thermal.asl.
+ *
+ * HFSP values: 0x80 = EC automatic, 0x01-0x07 = fixed regulated level.
+ * Level 4 is the resting state and MUST stay 0x80 so the EC curve remains
+ * active as a safety net (0x00 would mean fan off with the curve disabled).
+ */
+#define FAN4_HFSP		0x80	/* resting state - EC automatic */
+#define FAN3_HFSP		0x02
+#define FAN2_HFSP		0x04
+#define FAN1_HFSP		0x05	/* 0x06 measured identical to FAN0 */
+#define FAN0_HFSP		0x07	/* fastest REGULATED level */
+
+/*
+ * Trip points in degrees C, 8 K hysteresis. _AC0 is the FASTEST level
+ * (ACPI defines it so). The zone is polled every 10 s (_TZP) and a
+ * sustained all-core load gains 10-15 K between polls, so the top step
+ * must engage well below the passive trip (\TPSV, 90): at 85 it lost that
+ * race and ran on into the critical trip - the last resort, not part of
+ * the curve.
+ */
+#define FAN0_THRESHOLD_ON	80
+#define FAN0_THRESHOLD_OFF	72
+#define FAN1_THRESHOLD_ON	72
+#define FAN1_THRESHOLD_OFF	64
+#define FAN2_THRESHOLD_ON	64
+#define FAN2_THRESHOLD_OFF	56
+#define FAN3_THRESHOLD_ON	54
+#define FAN3_THRESHOLD_OFF	46
+
+#endif /* VARIANT_THERMAL_H */

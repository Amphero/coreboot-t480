diff --git a/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c b/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c
index db1b18ac..247153ec 100644
--- a/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c
+++ b/src/mainboard/lenovo/sklkbl_thinkpad/ramstage.c
@@ -1,5 +1,7 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
+#include <acpi/acpigen.h>
+#include <option.h>
 #include <soc/ramstage.h>
 #include "variant.h"
 
@@ -9,13 +11,31 @@ void mainboard_silicon_init_params(FSP_SIL_UPD *params)
 	variant_config_gpios();
 }
 
+/*
+ * One SSDT hook for everything the board adds: the dGPU description
+ * (when present) and the fan profile chosen in the setup menu, published
+ * as \FPRO for the thermal zone (ec/lenovo/h8/acpi/thermal.asl reads it).
+ * Keep it chained - assigning ssdt_add_dgpu directly here would drop the
+ * fan profile, assigning only a fan hook would drop the dGPU from ACPI.
+ */
+static void mainboard_fill_ssdt(const struct device *dev)
+{
+	if (CONFIG(VARIANT_HAS_DGPU))
+		ssdt_add_dgpu(dev);
+
+	if (CONFIG(H8_FAN_STEPPED)) {
+		unsigned int prof = get_uint_option("fan_profile", 1);
+		if (prof > 3)
+			prof = 1;
+		acpigen_write_name_integer("\\FPRO", prof);
+	}
+}
 
 static void mainboard_enable(struct device *dev)
 {
-	if (CONFIG(VARIANT_HAS_DGPU)) {
+	if (CONFIG(VARIANT_HAS_DGPU))
 		dgpu_detect();
-		dev->ops->acpi_fill_ssdt = ssdt_add_dgpu;
-	}
+	dev->ops->acpi_fill_ssdt = mainboard_fill_ssdt;
 }
 
 struct chip_operations mainboard_ops = {

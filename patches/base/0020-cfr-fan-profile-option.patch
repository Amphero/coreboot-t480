+/*
+ * Fan profiles for the setup-menu option "fan_profile" (published as
+ * \FPRO by ramstage.c). One row per profile; each row lists the
+ * _AC0-_AC3 ON/OFF pairs in degrees C for the FTBL package in
+ * ec/lenovo/h8/acpi/thermal.asl.
+ *
+ * "EC only" parks all four trips 1 K staggered just below \TCRT (100 C):
+ * the EC curve rules alone, but if it ever fails there is still an ACPI
+ * escalation before the critical shutdown. Do NOT disable the trips
+ * instead - that would remove the safety net entirely.
+ */
+#define FAN_PROFILE_QUIET	88, 80,  80, 72,  72, 64,  64, 56
+#define FAN_PROFILE_BALANCED	FAN0_THRESHOLD_ON, FAN0_THRESHOLD_OFF, \
+				FAN1_THRESHOLD_ON, FAN1_THRESHOLD_OFF, \
+				FAN2_THRESHOLD_ON, FAN2_THRESHOLD_OFF, \
+				FAN3_THRESHOLD_ON, FAN3_THRESHOLD_OFF
+#define FAN_PROFILE_PERFORMANCE	78, 70,  68, 60,  58, 50,  48, 40
+#define FAN_PROFILE_EC_ONLY	96, 94,  95, 93,  94, 92,  93, 91
+
 #endif /* VARIANT_THERMAL_H */

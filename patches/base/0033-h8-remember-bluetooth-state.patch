diff --git a/src/ec/lenovo/h8/Kconfig b/src/ec/lenovo/h8/Kconfig
index 33c2c779..b6ca296b 100644
--- a/src/ec/lenovo/h8/Kconfig
+++ b/src/ec/lenovo/h8/Kconfig
@@ -116,6 +116,15 @@ config H8_EXTENDED_HOTKEYS
 	  Lenovo hotkey codes (0x11xx/0x13xx) the kernel expects, instead
 	  of legacy codes that map to KEY_UNKNOWN or generic KEY_FN_*.
 
+config H8_BLUETOOTH_KEEP_STATE
+	bool
+	default n
+	help
+	  Give the "bluetooth" option a third value, "Last state", and make it
+	  the default. The EC bit is then left untouched at boot instead of
+	  being forced to the option value, so a radio the OS switched off
+	  through HKEY.SBDC stays off across a reboot.
+
 config H8_FAN_STEPPED
 	bool
 	default n
diff --git a/src/ec/lenovo/h8/bluetooth.c b/src/ec/lenovo/h8/bluetooth.c
index 2f9d8995..8335cff3 100644
--- a/src/ec/lenovo/h8/bluetooth.c
+++ b/src/ec/lenovo/h8/bluetooth.c
@@ -54,3 +54,18 @@ bool h8_bluetooth_nv_enable(void)
 {
 	return get_uint_option("bluetooth", true);
 }
+
+/*
+ * Is the option set to "Last state"? The EC keeps register 0x3a across a
+ * reset, so not writing it leaves the radio the way the OS left it - that
+ * is the only way an OS-side "bluetooth off" survives a reboot, coreboot
+ * has no other memory of it.
+ */
+bool h8_bluetooth_nv_keep_state(void)
+{
+	if (!CONFIG(H8_BLUETOOTH_KEEP_STATE))
+		return false;
+
+	return get_uint_option("bluetooth", H8_BLUETOOTH_LAST_STATE) ==
+		H8_BLUETOOTH_LAST_STATE;
+}
diff --git a/src/ec/lenovo/h8/cfr.c b/src/ec/lenovo/h8/cfr.c
index a4d564ed..b70bd3d8 100644
--- a/src/ec/lenovo/h8/cfr.c
+++ b/src/ec/lenovo/h8/cfr.c
@@ -26,15 +26,36 @@ static const struct sm_object fw_version = SM_DECLARE_VARCHAR({
 static void update_bluetooth(struct sm_object *new)
 {
 	if (!(CONFIG(H8_SUPPORT_BT_ON_WIFI) || h8_has_bdc()))
+#if CONFIG(H8_BLUETOOTH_KEEP_STATE)
+		new->sm_enum.flags = CFR_OPTFLAG_SUPPRESS;
+#else
 		new->sm_bool.flags = CFR_OPTFLAG_SUPPRESS;
+#endif
 }
 
+#if CONFIG(H8_BLUETOOTH_KEEP_STATE)
+static const struct sm_object bluetooth = SM_DECLARE_ENUM({
+	.opt_name	= "bluetooth",
+	.ui_name	= "Bluetooth",
+	.ui_helptext	= "Enable or disable the bluetooth module. \"Last "
+			  "state\" leaves the radio the way the OS left it, "
+			  "so switching it off survives a reboot.",
+	.default_value	= H8_BLUETOOTH_LAST_STATE,
+	.values		= (const struct sm_enum_value[]) {
+		{ "Disabled",	0 },
+		{ "Enabled",	1 },
+		{ "Last state",	H8_BLUETOOTH_LAST_STATE },
+		SM_ENUM_VALUE_END
+	},
+}, WITH_CALLBACK(update_bluetooth));
+#else
 static const struct sm_object bluetooth = SM_DECLARE_BOOL({
 	.opt_name	= "bluetooth",
 	.ui_name	= "Bluetooth",
 	.ui_helptext	= "Enable or disable the bluetooth module",
 	.default_value	= true,
 }, WITH_CALLBACK(update_bluetooth));
+#endif
 
 static const struct sm_enum_value kic_values_both[] = {
 	{ "Both",		KIC_BOTH	},
diff --git a/src/ec/lenovo/h8/h8.c b/src/ec/lenovo/h8/h8.c
index 52c02ef8..99a16f5b 100644
--- a/src/ec/lenovo/h8/h8.c
+++ b/src/ec/lenovo/h8/h8.c
@@ -420,9 +420,11 @@ static void h8_enable(struct device *dev)
 	if (volume <= 0xff && !acpi_is_wakeup_s3())
 		ec_write(H8_VOLUME_CONTROL, volume);
 
-	val = (CONFIG(H8_SUPPORT_BT_ON_WIFI) || h8_has_bdc()) &&
-		h8_bluetooth_nv_enable();
-	h8_bluetooth_enable(val);
+	if (!h8_bluetooth_nv_keep_state()) {
+		val = (CONFIG(H8_SUPPORT_BT_ON_WIFI) || h8_has_bdc()) &&
+			h8_bluetooth_nv_enable();
+		h8_bluetooth_enable(val);
+	}
 
 	val = h8_has_wwan() && h8_wwan_nv_enable();
 	h8_wwan_enable(val);

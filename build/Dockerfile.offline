# SPDX-License-Identifier: GPL-3.0-only
# coreboot T480 build with EDK2/UEFI payload  -  PHASE 2 (BUILD, fully OFFLINE)
#
# Compiles the firmware from the sources PHASE 1 (./fetch.sh) fetched. No
# network access; built with:
#
#   podman build --network=none \
#       --build-arg MAC_ADDRESS="xx:xx:xx:xx:xx:xx" \
#       -f build/Dockerfile.offline -t coreboot-t480 \
#       sources                            # <-- build context IS the sources tree
#
# scripts/build-firmware.py does exactly this. defconfig, splash.bmp and
# apply-devicetree.sh come from the build context too - ./fetch.sh copies them
# there from config/ and build/.
#
# Everything the build needs is in that context:
#   coreboot/            full checkout @ pinned commit, submodules populated,
#                        util/crossgcc/tarballs/ pre-filled (no toolchain download)
#   edk2/mrchromebox/    MrChromebox EDK2 clone (+ submodules), pre-placed into
#                        coreboot's edk2 workspace so it is NOT cloned online
#   lbmk/                libreboot build kit, cache pre-populated (offline inject)
#   libreboot/*.tar.xz   the libreboot release tarball
#   defconfig, splash.bmp
#
# The FROM image (coreboot-t480-deps) carries every apt/pip dependency and is
# built once, with network, by ./fetch.sh. Nothing here runs apt-get.

# ---------- Stage 1: libreboot injection (OFFLINE) ----------
# Runs `mk inject` using the pre-populated lbmk cache to produce a ROM with a
# correctly deguarded ME (lbmk's T480 delta + me_cleaner) and the GbE MAC set.
# Every download `mk inject` would normally do was pre-fetched in PHASE 1, so
# this stage needs no network.
FROM coreboot-t480-deps AS libreboot

ARG MAC_ADDRESS
RUN test -n "$MAC_ADDRESS" || { echo "ERROR: MAC_ADDRESS build arg is required"; exit 1; }

# lbmk (with its populated cache/, src/, elf/, vendorfiles/) and the tarball.
COPY lbmk /opt/lbmk
COPY libreboot /opt/lbmk-libreboot
RUN chown -R builder:builder /opt/lbmk /opt/lbmk-libreboot

USER builder
WORKDIR /opt/lbmk
# lbmk refuses to run as root; git needs an identity + ownership allowance.
RUN git config --global user.name "builder" && \
    git config --global user.email "builder@localhost" && \
    git config --global --add safe.directory '*'

# Offline inject: XBMK_CACHE defaults to /opt/lbmk/cache (pre-populated in PHASE 1).
RUN set -e; \
    TB="$(ls /opt/lbmk-libreboot/*.tar.xz | head -1)"; \
    test -n "$TB" || { echo "ERROR: no libreboot tarball in build context"; exit 1; }; \
    cp "$TB" /opt/lbmk/; \
    LTB="/opt/lbmk/$(basename "$TB")"; \
    echo "== lbmk inject (offline) $(basename "$TB") setmac $MAC_ADDRESS =="; \
    XBMK_THREADS="$(nproc)" ./mk inject "$LTB" setmac "$MAC_ADDRESS"; \
    tar -xf "$LTB"; \
    ROM="$(ls bin/*/seagrub_*_libgfxinit_corebootfb_usqwerty.rom 2>/dev/null | head -1)"; \
    test -n "$ROM" || { echo "ERROR: injected ROM not found"; ls -R bin || true; exit 1; }; \
    cp "$ROM" /opt/lbmk/injected.rom; \
    echo "== injected ROM: $ROM =="
# (write to /opt/lbmk - owned by 'builder'; /opt itself is root-owned)

# ---------- Stage 2: coreboot + EDK2 build (OFFLINE) ----------
FROM coreboot-t480-deps

# coreboot: full checkout with submodules and crossgcc tarballs. The toolchain
# builds FIRST from the pristine tree; defconfig, patches, EDK2 and the splash
# land in later layers, so changing them does not invalidate the slow one.
COPY --chown=builder:builder coreboot /opt/coreboot

USER builder
WORKDIR /opt/coreboot
RUN git config --global user.name "builder" && \
    git config --global user.email "builder@localhost" && \
    git config --global --add safe.directory '*'

RUN echo "" && echo "======= STEP 1 - building cross-compiler (from pre-fetched tarballs) =======" && echo ""
# No retry loop: with the tarballs pre-fetched this succeeds in one pass, and a
# download attempt fails fast under --network=none - which is the right signal,
# a gap in PHASE 1. Needs no .config, crossgcc is a standalone target.
RUN make crossgcc-i386 CPUS="$(nproc)"

# defconfig + board.conf + optional splash (glob form tolerates a missing splash).
COPY --chown=builder:builder defconfig /opt/coreboot/defconfig
COPY --chown=builder:builder board.conf /opt/coreboot/board.conf
COPY --chown=builder:builder splash.bmp* /opt/coreboot/
# Config-driven devicetree toggles (reads the DT_DEVICE markers in board.conf,
# edits the board devicetree.cb before `make`).
COPY --chown=builder:builder apply-devicetree.sh /opt/apply-devicetree.sh
# vboot signing keys. Empty unless keys/ exists in the project; the defconfig
# then keeps pointing at the vboot devkeys.
COPY --chown=builder:builder keys /opt/keys
# The MrChromebox EDK2 clone in coreboot's edk2 workspace: the directory exists,
# so coreboot's edk2 Makefile skips its `git clone`. A `git fetch origin` it
# still tries fails harmlessly - ref and submodules are already here.
COPY --chown=builder:builder edk2/mrchromebox /opt/coreboot/payloads/external/edk2/workspace/mrchromebox
# The deguarded/MAC-injected ROM from stage 1 - source of ifd.bin/me.bin/gbe.bin.
COPY --from=libreboot --chown=builder:builder /opt/lbmk/injected.rom /opt/libreboot.rom

# Board patches from patches/base/, in lexical order (mirrored into the build
# context by fetch.sh and build-firmware.py::sync_build_config). What each one
# does is in patches/README.md. Every patch MUST apply - the former inline seds
# missed silently and produced a ROM without the change.
COPY --chown=builder:builder patches /opt/patches
RUN set -e; cd /opt/coreboot; \
    for p in /opt/patches/base/*.patch; do \
      [ -e "$p" ] || continue; \
      echo "[patch] $(basename "$p")"; \
      git apply --check "$p" || { echo "ERROR: $(basename "$p") does not apply - fix patches/base/"; exit 1; }; \
      git apply "$p"; \
    done

# Payload patches from patches/edk2/, same rules, against the EDK2 tree copied
# in above. Separate from base/ because that is a different upstream on its own
# release cycle - a patch that stops applying should name its tree.
RUN set -e; cd /opt/coreboot/payloads/external/edk2/workspace/mrchromebox; \
    for p in /opt/patches/edk2/*.patch; do \
      [ -e "$p" ] || continue; \
      echo "[patch] edk2/$(basename "$p")"; \
      git apply --check "$p" || { echo "ERROR: edk2/$(basename "$p") does not apply - fix patches/edk2/"; exit 1; }; \
      git apply "$p"; \
    done

# Config-driven: enable/disable the optional devicetree devices (smbus/heci1/
# fast_spi) per the "DT_DEVICE NAME=y/n" markers in board.conf, before `make`.
RUN sh /opt/apply-devicetree.sh /opt/coreboot

RUN echo "" && echo "======= STEP 2 - extracting blobs from libreboot ROM =======" && echo ""
RUN mkdir -p binaries && \
    make -C util/ifdtool && \
    util/ifdtool/ifdtool -x -p sklkbl /opt/libreboot.rom && \
    mv flashregion_0_flashdescriptor.bin binaries/ifd.bin && \
    mv flashregion_2_intel_me.bin binaries/me.bin && \
    mv flashregion_3_gbe.bin binaries/gbe.bin && \
    rm -f flashregion_*.bin

RUN echo "" && echo "======= STEP 3 - loading defconfig =======" && echo ""
# If splash.bmp was not provided, strip the two splash options from defconfig.
RUN [ -f /opt/coreboot/splash.bmp ] || \
    sed -i '/CONFIG_EDK2_BOOTSPLASH_FILE/d; /CONFIG_EDK2_FOLLOW_BGRT_SPEC/d' /opt/coreboot/defconfig
RUN cp defconfig .config && make olddefconfig

# Pin coreboot's EDK2 revision to what PHASE 1 placed in workspace/mrchromebox:
# the commit from versions.lock, the branch name as fallback. coreboot's Kconfig
# default may name another branch - 26.06 defaults to uefipayload_2603.
ARG EDK2_BRANCH
ARG EDK2_COMMIT
RUN REV="$EDK2_COMMIT"; [ -n "$REV" ] || REV="${EDK2_BRANCH:+origin/$EDK2_BRANCH}"; \
    if [ -n "$REV" ]; then \
      if grep -q '^CONFIG_EDK2_TAG_OR_REV=' .config; then \
        sed -i 's|^\(CONFIG_EDK2_TAG_OR_REV=\).*|\1"'"$REV"'"|' .config; \
      else \
        echo "CONFIG_EDK2_TAG_OR_REV=\"$REV\"" >> .config; \
      fi; \
      grep -q "^CONFIG_EDK2_TAG_OR_REV=\"$REV\"\$" .config \
        || { echo "ERROR: failed to pin CONFIG_EDK2_TAG_OR_REV"; exit 1; }; \
      echo "== EDK2 pinned to $REV =="; \
    fi

RUN echo "" && echo "======= STEP 4 - building coreboot =======" && echo ""
RUN make -j"$(nproc)"

RUN echo "" && echo "======= DONE - /opt/coreboot/build/coreboot.rom is ready =======" && echo ""
CMD ["bash"]

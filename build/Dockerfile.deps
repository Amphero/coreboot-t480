# SPDX-License-Identifier: GPL-3.0-only
# coreboot-t480-deps  -  build-environment base image (PHASE 1 artifact)
#
# This image contains ONLY the toolchain / OS packages needed to build the
# firmware - no sources. It is built ONCE with network access during the fetch
# phase (./fetch.sh). The actual firmware build (PHASE 2) does `FROM
# coreboot-t480-deps`, adds the pre-fetched ./sources/<mode>/ tree and compiles
# with `--network=none`.
#
# The package set is the UNION of:
#   * coreboot's build/EDK2 dependencies (build-essential, gnat, nasm, acpica,
#     uuid-dev, imagemagick, innoextract, pefile, ...)
#   * libreboot/lbmk's full Debian dependency list (config/dependencies/debian)
#     - needed by `./mk inject` (me_cleaner, deguard, ifdtool, nvmutil, Intel-ME
#     extraction via innoextract/p7zip/pycryptodome, efitools, ...).
#
# Keeping the union here means neither build stage ever needs `apt-get` (i.e. no
# network) in PHASE 2.

# Pinned by digest: the base layer is the one non-reproducible input of the
# otherwise fully locked build (versions.lock pins every source). Digest of
# debian:bookworm as pulled on 2026-08-01; bump deliberately, with a rebuild.
FROM debian:bookworm@sha256:41a613df4beca480a97c22b1f6837f7502cb95206e2cc2daf1ea3cb28f8755ab

ENV DEBIAN_FRONTEND=noninteractive

# --- libreboot/lbmk Debian dependency list (verbatim from config/dependencies/debian)
#     + coreboot/EDK2 extras (ca-certificates gnupg sudo python3-pip xz-utils
#     vim xxd imagemagick libelf-dev software-properties-common). ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    acpica-tools autoconf autogen automake autopoint autotools-dev bc \
    binutils-arm-none-eabi bison build-essential cmake curl device-tree-compiler \
    doxygen e2fsprogs efitools flex fonts-unifont gawk gcc-arm-linux-gnueabi \
    gcc-arm-none-eabi gdb gettext git gnat help2man innoextract libdevmapper-dev \
    libfdt-dev libfont-freetype-perl libfreetype-dev libftdi-dev libftdi1-dev libfuse-dev \
    libjaylink-dev libgnutls28-dev libgpiod-dev lz4 liblz4-dev liblzma-dev libncurses5-dev \
    libncurses-dev libnewlib-arm-none-eabi libopts25 libopts25-dev libpci-dev libpython3-dev \
    libsdl2-dev libselinux1-dev libssl-dev libtool libusb-1.0-0 libusb-1.0-0-dev \
    libusb-dev lzma lzma-alone m4 nasm openssl p7zip p7zip-full parted pciutils \
    perl pkg-config python3 python3-distutils-extra python3-pkg-resources python3-pycryptodome \
    python3-pyelftools python3-setuptools python-is-python3 sharutils swig unar \
    unifont unifont-bin unzip uuid-dev wget xfonts-unifont zlib1g-dev ccache gcab \
    g++-mipsel-linux-gnu make genisoimage mtools libx86-1 libx86-dev libstdc++-arm-none-eabi-newlib autoconf-archive \
    ca-certificates gnupg sudo python3-pip xz-utils vim xxd imagemagick libelf-dev software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# EDK2's C blob compressor wants `pefile`; not packaged widely enough, install via pip.
RUN pip3 install --break-system-packages pefile

# `builder`: an unprivileged user. Both PHASE-2 build stages run as this user
# because lbmk refuses to run as root (xbmk_init: "this command as root is not
# permitted"), and it keeps the coreboot/EDK2 build off root too. No sudoers
# entry: nothing in either build phase escalates, and a passwordless-root user
# would defeat the point of dropping privileges.
RUN useradd -m -s /bin/bash builder

CMD ["bash"]
